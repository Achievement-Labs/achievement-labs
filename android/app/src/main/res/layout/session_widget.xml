<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical" android:padding="14dp" android:background="@drawable/session_widget_background">
 <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Achievement Labs" android:textColor="#ffffff" android:textStyle="bold" android:textSize="16sp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="7dp" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_spoof_title" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Spoofing stopped" android:textColor="#67e68a" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"/>
  <Chronometer android:id="@+id/widget_spoof_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#ffffff" android:textSize="20sp"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_queue_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingTop="7dp" android:text="Auto Unlock paused" android:textColor="#67e68a" android:textSize="13sp" android:maxLines="1" android:ellipsize="end"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
  <TextView android:id="@+id/widget_next_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Open app to review" android:textColor="#ffffff" android:textSize="13sp" android:maxLines="2" android:ellipsize="end"/>
  <Chronometer android:id="@+id/widget_unlock_timer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#ffffff" android:textSize="20sp"/>
 </LinearLayout>
 <TextView android:id="@+id/widget_updated" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Open app for current status" android:textColor="#a6aea8" android:textSize="10sp"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
  <Button android:id="@+id/widget_open" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="Open / resume" android:textAllCaps="false" android:textSize="11sp" android:padding="0dp" android:textColor="#67e68a" android:background="@android:color/transparent"/>
  <Button android:id="@+id/widget_pause" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="Pause queue" android:textAllCaps="false" android:textSize="11sp" android:padding="0dp" android:textColor="#67e68a" android:background="@android:color/transparent"/>
  <Button android:id="@+id/widget_stop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp" android:text="Stop spoof" android:textAllCaps="false" android:textSize="11sp" android:padding="0dp" android:textColor="#67e68a" android:background="@android:color/transparent"/>
 </LinearLayout>
</LinearLayout>
