<Project>
  <PropertyGroup>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">false</DebugSymbols>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
    <LabsPortableDesktop Condition="'$(LabsMacOS)' == 'true' Or '$(LabsLinux)' == 'true'">true</LabsPortableDesktop>
  </PropertyGroup>
  <Target Name="ValidateDesktopPlatform" BeforeTargets="PrepareForBuild" Condition="'$(LabsMacOS)' == 'true' And '$(LabsLinux)' == 'true'">
    <Error Text="Choose exactly one desktop platform: LabsMacOS or LabsLinux." />
  </Target>
</Project>
