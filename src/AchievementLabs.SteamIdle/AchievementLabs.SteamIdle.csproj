<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>AchievementLabs.SteamIdle</AssemblyName>
    <RootNamespace>AchievementLabs.SteamIdle</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile
      Include="..\..\vendor\SteamAchievementManager\SAM.API\**\*.cs"
      LinkBase="References\SAM.API"
      Exclude="..\..\vendor\SteamAchievementManager\SAM.API\GlobalSuppressions.cs;..\..\vendor\SteamAchievementManager\SAM.API\bin\**\*.cs;..\..\vendor\SteamAchievementManager\SAM.API\obj\**\*.cs" />
  </ItemGroup>

</Project>
