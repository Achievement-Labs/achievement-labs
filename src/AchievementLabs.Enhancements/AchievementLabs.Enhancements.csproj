<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <AssemblyName>AchievementLabs.MultiSelect</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <EmbeddedResource Include="EditionMappings.json" LogicalName="AchievementLabs.MultiSelect.EditionMappings.json" />
  </ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../catalog/achievement-packs.json" LogicalName="AchievementLabs.SharedPacks.json" /></ItemGroup>
  <ItemGroup><EmbeddedResource Include="../../catalog/achievement-hubs.json" LogicalName="AchievementLabs.SharedHubs.json" /></ItemGroup>
</Project>
