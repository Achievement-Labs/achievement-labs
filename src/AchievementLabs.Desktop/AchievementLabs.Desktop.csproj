<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework Condition="'$(LabsPortableDesktop)' != 'true'">net9.0-windows10.0.19041.0</TargetFramework>
    <TargetFramework Condition="'$(LabsPortableDesktop)' == 'true'">net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings><Nullable>enable</Nullable>
    <ApplicationManifest Condition="'$(LabsPortableDesktop)' != 'true'">app.manifest</ApplicationManifest>
    <ApplicationIcon>../AchievementLabs.App/app.ico</ApplicationIcon>
    <AssemblyName>AchievementLabs</AssemblyName>
    <Version>1.1.0</Version>
    <AssemblyVersion>1.1.0.0</AssemblyVersion>
    <FileVersion>1.1.0.0</FileVersion>
    <InformationalVersion>1.1.0</InformationalVersion>
  </PropertyGroup>

  <ItemGroup><ProjectReference Include="../AchievementLabs.Enhancements/AchievementLabs.Enhancements.csproj" /></ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.2" Condition="'$(LabsPortableDesktop)' != 'true'" />
    <PackageReference Include="ZXing.Net" Version="0.16.11" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
  </ItemGroup>
<ItemGroup><ProjectReference Include="../AchievementLabs.Core/AchievementLabs.Core.csproj" /></ItemGroup><ItemGroup>
<AvaloniaResource Include="../AchievementLabs.App/Assets/achievement-labs-icon.png" Link="Assets/achievement-labs-logo.png"/>
<AvaloniaResource Include="../../images.jpg" Link="Assets/xbox-logo.jpg"/>
<AvaloniaResource Include="../../Steam_icon_logo.svg.webp" Link="Assets/steam-logo.webp"/>
<AvaloniaResource Include="../../Epic_Games_Store_logo_2023_vertical_black.png" Link="Assets/epic-logo.png"/>
<AvaloniaResource Include="../../Ubisoft_logo.png" Link="Assets/ubisoft-logo.png"/>
<EmbeddedResource Include="../../site/assets/games.json" LogicalName="AchievementLabs.PublicCatalog.json"/>
<!-- The public 1.0.5 event snapshot is embedded by Core; private service data is not packaged. -->
<Content Include="../AchievementLabs.App/StatsCatalog/**/*.*" LinkBase="StatsCatalog" CopyToOutputDirectory="PreserveNewest"/>
<Content Include="../../gfwlam/**/*.*" LinkBase="gfwlam" CopyToOutputDirectory="PreserveNewest"/>
<Content Include="../../tools/Submit-ColdAlleyAchievements.ps1" Link="tools/Submit-ColdAlleyAchievements.ps1" CopyToOutputDirectory="PreserveNewest"/>
<Content Include="../../uplayachievements/**/*.*" LinkBase="uplayachievements" CopyToOutputDirectory="PreserveNewest"/>
<Content Include="../../Uplay spools/**/*.spool" LinkBase="Uplay spools" CopyToOutputDirectory="PreserveNewest"/>
</ItemGroup>
<Target Name="BuildNativeHelpers" Condition="'$(LabsSingleFile)' != 'true' And '$(LabsPortableDesktop)' != 'true'" BeforeTargets="Build">
<RemoveDir Directories="$(MSBuildProjectDirectory)/obj/steam-idle;$(MSBuildProjectDirectory)/obj/gfwl-injector" />
<MSBuild Projects="../AchievementLabs.SteamIdle/AchievementLabs.SteamIdle.csproj" Targets="Restore;Build" RemoveProperties="RuntimeIdentifier;SelfContained" Properties="Configuration=$(Configuration);OutputPath=$(MSBuildProjectDirectory)/obj/steam-idle/;NuGetAudit=false"/>
<MSBuild Projects="../AchievementLabs.GfwlInjector/AchievementLabs.GfwlInjector.csproj" Targets="Restore;Build" RemoveProperties="RuntimeIdentifier;SelfContained" Properties="Configuration=$(Configuration);Platform=x86;OutputPath=$(MSBuildProjectDirectory)/obj/gfwl-injector/;NuGetAudit=false"/>
</Target>
<Target Name="CopyNativeHelpers" Condition="'$(LabsSingleFile)' != 'true' And '$(LabsPortableDesktop)' != 'true'" AfterTargets="Build">
<RemoveDir Directories="$(OutDir)steam-idle;$(OutDir)gfwl" />
<ItemGroup><SteamHelper Include="$(MSBuildProjectDirectory)/obj/steam-idle/**/*.*"/><GfwlHelper Include="$(MSBuildProjectDirectory)/obj/gfwl-injector/**/*.*"/></ItemGroup>
<Copy SourceFiles="@(SteamHelper)" DestinationFiles="@(SteamHelper->'$(OutDir)steam-idle/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
<Copy SourceFiles="@(GfwlHelper)" DestinationFiles="@(GfwlHelper->'$(OutDir)gfwl/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
</Target>
<Target Name="PublishNativeHelpers" Condition="'$(LabsSingleFile)' != 'true' And '$(LabsPortableDesktop)' != 'true'" AfterTargets="Publish">
<ItemGroup><PublishedSteamHelper Include="$(OutDir)steam-idle/**/*.*"/><PublishedGfwlHelper Include="$(OutDir)gfwl/**/*.*"/></ItemGroup>
<Error Condition="'@(PublishedSteamHelper)' == '' Or '@(PublishedGfwlHelper)' == ''" Text="Native helper outputs are missing. Build before publishing."/>
<Copy SourceFiles="@(PublishedSteamHelper)" DestinationFiles="@(PublishedSteamHelper->'$(PublishDir)steam-idle/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
<Copy SourceFiles="@(PublishedGfwlHelper)" DestinationFiles="@(PublishedGfwlHelper->'$(PublishDir)gfwl/%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true"/>
</Target>
<Target Name="BundleReleaseHelpers" BeforeTargets="_ComputeFilesToBundle" Condition="'$(LabsSingleFile)' == 'true'">
  <Error Condition="'$(LabsHelperDirectory)' == ''" Text="Use tools/Build-Release.ps1 to prepare self-contained helpers." />
  <ItemGroup>
    <ReleaseHelper Include="$(LabsHelperDirectory)/**/*.*" Exclude="$(LabsHelperDirectory)/**/*.pdb" />
    <ResolvedFileToPublish Include="@(ReleaseHelper)">
      <RelativePath>%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </ResolvedFileToPublish>
    <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    <ForbiddenReleaseFile Include="@(ResolvedFileToPublish)" Condition="$([System.Text.RegularExpressions.Regex]::IsMatch('%(ResolvedFileToPublish.RelativePath)', '(?i)(^|[/\\])(Events|server|private)([/\\]|$)|\.(cs|axaml|csproj|pdb|py|xlsx)$|(^|[/\\])(Data|titleid|auth|settings)\.json$'))" />
  </ItemGroup>
  <Error Condition="'@(ForbiddenReleaseFile)' != ''" Text="Private/source files found in release: @(ForbiddenReleaseFile)" />
</Target>
<PropertyGroup Condition="'$(LabsMacOS)' == 'true'">
  <DefineConstants>$(DefineConstants);LABS_MACOS</DefineConstants><AssemblyVersion>0.1.1.1</AssemblyVersion><FileVersion>0.1.1.1</FileVersion><InformationalVersion>0.1.1-macos-preview.1</InformationalVersion>
</PropertyGroup>
<ItemGroup Condition="'$(LabsPortableDesktop)' == 'true'">
  <Content Remove="../../gfwlam/**/*.*;../../uplayachievements/**/*.*;../../Uplay spools/**/*.spool;../../tools/Submit-ColdAlleyAchievements.ps1" />
</ItemGroup>
<PropertyGroup Condition="'$(LabsLinux)' == 'true'">
  <DefineConstants>$(DefineConstants);LABS_LINUX</DefineConstants>
  <AssemblyVersion>0.1.1.1</AssemblyVersion><FileVersion>0.1.1.1</FileVersion><InformationalVersion>0.1.1-linux-preview.1</InformationalVersion>
</PropertyGroup>
<ItemGroup Condition="'$(LabsLinux)' == 'true'">
  <Content Include="../../tools/linux/microsoft-signin.py" Link="Helpers/microsoft-signin.py" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
</ItemGroup>
</Project>

