<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AchievementLabs.Desktop" xmlns:workflows="using:AchievementLabs.Desktop.Workflows" xmlns:models="clr-namespace:AchievementLabs.Models;assembly=AchievementLabs.Core" xmlns:gfwl="clr-namespace:AchievementLabs.Services.Gfwl;assembly=AchievementLabs.Core" xmlns:core="clr-namespace:AchievementLabs.Core;assembly=AchievementLabs.Core"
        x:Class="AchievementLabs.Desktop.MainWindow" x:CompileBindings="True" x:DataType="local:DesktopModel" Title="Achievement Labs 1.0.3" Width="1440" Height="920" MinWidth="1120" MinHeight="720" Background="#000000" FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter" WindowStartupLocation="CenterScreen">
 <Design.DataContext><local:DesktopModel/></Design.DataContext>
 <Grid x:Name="PreviewRoot" Background="#000000" ColumnDefinitions="240,*" RowDefinitions="*,38">
  <Border Grid.RowSpan="2" Background="#050606" BorderBrush="#24272A" BorderThickness="0,0,1,0">
   <Grid RowDefinitions="Auto,*,Auto" Margin="20,26,16,18">
    <StackPanel Spacing="12">
     <Image Source="/Assets/achievement-labs-logo.png" Width="46" Height="46" HorizontalAlignment="Left" Stretch="Uniform"/>
     <TextBlock Text="ACHIEVEMENT" FontWeight="Bold" FontSize="17" LetterSpacing="1.6"/>
     <TextBlock Text="LABS" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="11" LetterSpacing="3" Margin="0,-8,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,24,0,16"><StackPanel Spacing="5">
     <TextBlock Text="WORKSPACE" Classes="eyebrow" Margin="12,0,0,12"/>
     <Button Classes="nav" Classes.active="{Binding IsHome}" Click="ShowHome" Content="⌂     Home"/>
      <Expander IsExpanded="True"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="9"><Image Source="/Assets/xbox-logo.jpg" Width="18" Height="18" Stretch="UniformToFill"/><TextBlock Text="Xbox"/></StackPanel></Expander.Header><StackPanel Margin="10,4,0,6" Spacing="3"><Button x:Name="LibraryNav" Classes="nav" Classes.active="{Binding IsLibrary}" Click="ShowLibrary" Content="Library"/><Button Classes="nav" Classes.active="{Binding IsXbox360Profiles}" Click="ShowXbox360Profiles" Content="Xbox 360 profiles"/><Button Classes="nav" Classes.active="{Binding IsGfwl}" Click="ShowGfwl" Content="GFWL"/><Button x:Name="AchievementsNav" Classes="nav" Classes.active="{Binding IsAchievements}" Click="ShowAchievements" Content="Achievements"/><Button Classes="nav" Classes.active="{Binding IsSpoofer}" Content="Title spoofer" Click="ShowSpoofer"/><Button Classes="nav" Classes.active="{Binding IsStats}" Content="Stats editor" Click="ShowStats"/><Button Classes="nav" Classes.active="{Binding IsQueues}" Content="Auto unlocker" Click="ShowQueues"/><Button Classes="nav" Classes.active="{Binding IsLegacy}" Content="Legacy tools" Click="ShowLegacy"/><Button Classes="nav" Classes.active="{Binding IsDiagnostics}" Click="ShowDiagnostics" Content="Event catalog"/><Button Classes="nav" Classes.active="{Binding IsTools}" Content="Tools" Click="ShowTools"/></StackPanel></Expander>
      <Expander><Expander.Header><StackPanel Orientation="Horizontal" Spacing="9"><Image Source="/Assets/steam-logo.webp" Width="18" Height="18"/><TextBlock Text="Steam"/></StackPanel></Expander.Header><StackPanel Margin="10,4,0,6" Spacing="3"><Button Classes="nav" Classes.active="{Binding IsSteamLibrary}" Content="Library" Click="ShowSteam"/><Button Classes="nav" Classes.active="{Binding IsSteamAchievements}" Content="Achievements" Click="ShowSteamAchievements"/><Button Classes="nav" Classes.active="{Binding IsQueues}" Content="Auto unlocker" Click="ShowQueues"/></StackPanel></Expander>
      <Expander><Expander.Header><StackPanel Orientation="Horizontal" Spacing="9"><Border Background="#D5D8DC" CornerRadius="3" Width="18" Height="18"><Image Source="/Assets/epic-logo.png" Margin="2"/></Border><TextBlock Text="Epic Games"/></StackPanel></Expander.Header><StackPanel Margin="10,4,0,6"><Button Classes="nav" Classes.active="{Binding IsEpic}" Content="Library and achievements" Click="ShowEpic"/></StackPanel></Expander>
      <Expander><Expander.Header><StackPanel Orientation="Horizontal" Spacing="9"><Border Background="#D5D8DC" CornerRadius="9" Width="18" Height="18"><Image Source="/Assets/ubisoft-logo.png" Margin="2"/></Border><TextBlock Text="Ubisoft Connect"/></StackPanel></Expander.Header><StackPanel Margin="10,4,0,6"><Button Classes="nav" Classes.active="{Binding IsUbisoft}" Content="Library, data and injector" Click="ShowUbisoft"/></StackPanel></Expander>
     <Button Classes="nav" Classes.active="{Binding IsSettings}" Click="ShowSettings" Content="⚙     Settings"/>
      <Button Classes="nav" Classes.active="{Binding IsAbout}" Click="ShowAbout" Content="ⓘ     About"/>
<Border Height="1" Background="#24272A" Margin="10,22"/>


    </StackPanel>
    </ScrollViewer><StackPanel Grid.Row="2" Spacing="14">
      <Border Classes="panel" Padding="12"><StackPanel Spacing="6"><TextBlock Text="A space to experiment." FontSize="12"/><TextBlock Text="Achievement Labs 1.0.3" Classes="muted" FontSize="11"/></StackPanel></Border>
     <Grid ColumnDefinitions="34,*"><Grid Width="34" Height="34"><Border Background="#303642" CornerRadius="17"><TextBlock Text="U" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/></Border><Border CornerRadius="17" ClipToBounds="True"><local:RemoteImage Url="{Binding ProfileImageUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding ProfileName}" FontSize="12"/><TextBlock Text="{Binding ConnectionLabel}" Classes="muted" FontSize="10"/></StackPanel></Grid>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="30,24,30,20">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,22">
     <Button Content="←" Click="GoBack" IsEnabled="{Binding CanGoBack}" Margin="0,0,12,0"/>
     <TextBlock Grid.Column="1" Text="{Binding PageTitle}" FontSize="29" FontWeight="SemiBold" LetterSpacing="-0.8" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
     <Button Content="Attach Xbox PC app" Click="ConnectXbox" IsEnabled="{Binding CanConnect}"/><Button Content="Open export" Click="OpenExport" IsEnabled="{Binding CanInteract}"/>
     <Border Background="#21352E" CornerRadius="15" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="{Binding ConnectionLabel}" Foreground="#91CFB1" FontSize="11"/></Border>
    </StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="1" IsVisible="{Binding IsHome}">
    <StackPanel Spacing="20" MaxWidth="980">
     <Border Classes="panel" Padding="24"><Grid ColumnDefinitions="72,*"><Grid Width="64" Height="64"><Border Background="#151A17" CornerRadius="32"/><Border CornerRadius="32" ClipToBounds="True"><local:RemoteImage Url="{Binding ProfileImageUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="6"><TextBlock Text="{Binding ProfileName}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Connected accounts and local game services" Classes="muted"/></StackPanel></Grid></Border>
     <UniformGrid Columns="2" Rows="2">
      <Border Classes="panel" Padding="22" Margin="0,0,10,10"><Grid ColumnDefinitions="62,*"><Grid Width="52" Height="52"><Border Background="#151A17" CornerRadius="26"/><Border CornerRadius="26" ClipToBounds="True"><local:RemoteImage Url="{Binding ProfileImageUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Spacing="9"><TextBlock Text="XBOX" Classes="eyebrow"/><TextBlock Text="{Binding HomeXboxSummary}" FontSize="16" TextWrapping="Wrap"/><TextBlock Text="{Binding XboxPcAttachmentLabel}" Foreground="#91CFB1" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding XboxPcAttachmentDetail}" Classes="muted" TextWrapping="Wrap"/><WrapPanel><Button Content="Retry attachment" Click="ConnectXbox" IsEnabled="{Binding CanConnect}"/><Button Content="Open Xbox app" Click="LaunchXboxAndAttach" IsEnabled="{Binding CanConnect}" Margin="8,0,0,0"/><Button Content="Library" Click="ShowLibrary" Margin="8,0,0,0"/></WrapPanel></StackPanel></Grid></Border>
      <Border Classes="panel" Padding="22" Margin="10,0,0,10"><Grid ColumnDefinitions="62,*"><Grid Width="52" Height="52"><Image Source="/Assets/steam-logo.webp"/><Border CornerRadius="26" ClipToBounds="True"><local:RemoteImage Url="{Binding SteamAvatarUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="STEAM" Classes="eyebrow"/><TextBlock Text="{Binding HomeSteamSummary}" FontSize="16" TextWrapping="Wrap"/><Button Content="Open Steam" Click="ShowSteam" HorizontalAlignment="Left"/></StackPanel></Grid></Border>
      <Border Classes="panel" Padding="22" Margin="0,10,10,0"><StackPanel Spacing="12"><TextBlock Text="EPIC GAMES" Classes="eyebrow"/><TextBlock Text="Local installation and captured achievement data" Classes="muted" TextWrapping="Wrap"/><Button Content="Open Epic Games" Click="ShowEpic" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Classes="panel" Padding="22" Margin="10,10,0,0"><StackPanel Spacing="12"><TextBlock Text="UBISOFT CONNECT" Classes="eyebrow"/><TextBlock Text="Local installation and captured game data" Classes="muted" TextWrapping="Wrap"/><Button Content="Open Ubisoft" Click="ShowUbisoft" HorizontalAlignment="Left"/></StackPanel></Border>
     </UniformGrid>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="1" IsVisible="{Binding IsAchievements}" RowDefinitions="190,Auto,*">
    <Border CornerRadius="12" ClipToBounds="True" BorderBrush="#414245" BorderThickness="1">
     <Grid ColumnDefinitions="*,310">
      <Grid.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#343A43" Offset="0"/><GradientStop Color="#192029" Offset="0.7"/><GradientStop Color="#102017" Offset="1"/></LinearGradientBrush></Grid.Background>
      <StackPanel Margin="28,24" Spacing="11">
       <TextBlock Text="{Binding SelectedGame.Platform}" Classes="eyebrow"/>
       <TextBlock Text="{Binding SelectedGame.Name}" FontSize="26" FontWeight="SemiBold" LetterSpacing="-0.7" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding SelectedGame.Description}" Foreground="#B7BDC6" MaxWidth="650" HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="12"/>
       <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,5,0,0"><TextBlock Text="{Binding SelectedGame.ProgressLabel}" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedGame.ScoreLabel}" Foreground="{DynamicResource Accent}"/></StackPanel>
      </StackPanel>
      <Grid Grid.Column="1" ClipToBounds="True">
       <Ellipse Width="224" Height="224" Stroke="#356A44" StrokeThickness="1" Opacity="0.35" Margin="80,-20,-30,-40"/>
       <Ellipse Width="156" Height="156" Stroke="#63B77B" StrokeThickness="1" Opacity="0.3" Margin="80,0,-30,0"/>
       <Path Data="M 20,140 L 85,44 L 119,91 L 153,18 L 236,140 Z" Stroke="{DynamicResource Accent}" StrokeThickness="2" Opacity="0.55" Stretch="Uniform" Width="175" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding SelectedGame.Monogram}" FontSize="64" FontWeight="Bold" Opacity="0.18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <local:RemoteImage Url="{Binding SelectedGame.ImageUrl}" Stretch="UniformToFill" Opacity="0.82"/>
      </Grid>
     </Grid>
    </Border>
    <StackPanel Grid.Row="1" Spacing="10" Margin="0,18,0,14">
     <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding TitleLookup, Mode=TwoWay}" PlaceholderText="Open Xbox achievements by title ID…"/><Button Grid.Column="1" Content="Open title" Click="LookupTitle" IsEnabled="{Binding CanQuery}" Margin="10,0,0,0"/></Grid>
     <Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="AllFilter" Content="All achievements" Click="FilterAll"/><Button Content="Locked" Click="FilterLocked" Background="Transparent"/><Button Content="Unlocked" Click="FilterUnlocked" Background="Transparent"/></StackPanel><TextBox Grid.Column="1" Width="242" PlaceholderText="Search achievements…" Text="{Binding Search, Mode=TwoWay}"/></Grid>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,252">
     <Border Classes="panel" Margin="0,0,16,0">
      <Grid RowDefinitions="42,*,32">
       <Grid ColumnDefinitions="*,100,54" Margin="20,0" VerticalAlignment="Center"><TextBlock Text="ACHIEVEMENT" Classes="muted" FontSize="10" LetterSpacing="1"/><TextBlock Grid.Column="1" Text="STATUS" Classes="muted" FontSize="10"/><TextBlock Grid.Column="2" Text="SCORE" Classes="muted" FontSize="10"/></Grid>
       <ListBox Grid.Row="1" ItemsSource="{Binding VisibleAchievements}" SelectedItem="{Binding SelectedAchievement, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="6,0">
        <ListBox.ItemTemplate><DataTemplate x:DataType="local:Achievement">
         <Grid ColumnDefinitions="44,*,96,46" Margin="12,9">
          <Border Background="{Binding BadgeBackground}" Width="34" Height="34" CornerRadius="8"><TextBlock Text="{Binding Symbol}" Foreground="{Binding BadgeForeground}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border>
           <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12"/><TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="ID" Classes="muted" FontSize="9"/><TextBlock Text="{Binding Id}" Classes="muted" FontSize="9"/></StackPanel></StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Status}" Foreground="{Binding BadgeForeground}" FontSize="10" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="3" Text="{Binding CompactScoreLabel}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
         </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Grid.Row="2" Text="{Binding ResultLabel}" Classes="muted" FontSize="10" Margin="20,6"/>
       <TextBlock Grid.Row="1" Text="No achievements match your filters." IsVisible="{Binding NoResults}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <Border Grid.Column="1" Classes="panel" Padding="20">
      <ScrollViewer><StackPanel Spacing="15">
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh" Click="RefreshAchievements" IsEnabled="{Binding CanQuery}"/><Button Content="Export CSV" Click="ExportCsv" IsEnabled="{Binding CanExport}"/></StackPanel><TextBlock Text="ACHIEVEMENT DETAILS" Classes="eyebrow" FontSize="9"/>
       <Grid Width="56" Height="56" HorizontalAlignment="Left"><Border Background="#142018" CornerRadius="14"><TextBlock Text="◇" Foreground="{DynamicResource Accent}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border CornerRadius="14" ClipToBounds="True"><local:RemoteImage Url="{Binding SelectedAchievement.ImageUrl}" Stretch="UniformToFill"/></Border></Grid>
       <TextBlock Text="{Binding SelectedAchievement.Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding SelectedAchievement.Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
       <Border Height="1" Background="{DynamicResource Line}"/>
       <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Gamerscore" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding SelectedAchievement.ScoreLabel}" FontSize="12"/></Grid>
       <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Achievement ID" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding SelectedAchievement.Id}" FontSize="12"/></Grid>
       <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Status" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding SelectedAchievement.Status}" FontSize="12"/></Grid>

        <Border IsVisible="{Binding TitleTesting}" Background="#142018" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel Spacing="4"><TextBlock Text="Testing" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="This title is actively being tested. Achievement IDs may not match, and some unlock requests may not work. Please verify each result before continuing." TextWrapping="Wrap" Classes="muted"/></StackPanel></Border>
        <Border IsVisible="{Binding TitleComingSoon}" Background="#142018" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel Spacing="4"><TextBlock Text="Coming Soon" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="This title does not yet have a usable testing template." TextWrapping="Wrap" Classes="muted"/></StackPanel></Border>
       <Border IsVisible="{Binding TitleNotSupported}" Background="#211616" BorderBrush="#B56B6B" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel Spacing="4"><TextBlock Text="Not Supported" FontWeight="SemiBold" Foreground="#D88A8A"/><TextBlock Text="This event-based title does not currently have a supported event template." TextWrapping="Wrap" Classes="muted"/></StackPanel></Border>
       <Button Content="Unlock selected" Click="UnlockSelected" IsEnabled="{Binding CanUnlockSelected}" Classes="primary"/>
<Button Content="Unlock all locked" Click="UnlockAll" IsEnabled="{Binding CanUnlockAll}"/>
<TextBlock Text="{Binding ActionSummary}" TextWrapping="Wrap" Classes="muted" FontSize="11"/>
<ItemsControl ItemsSource="{Binding ActionReports}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ActionReport"><StackPanel Spacing="4" Margin="0,4"><TextBlock Text="{Binding Achievement}" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding Result}" TextWrapping="Wrap" Classes="muted" FontSize="10"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Refresh after a request to check account progress." Classes="muted" FontSize="10" TextWrapping="Wrap" LineHeight="17"/>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid>
   </Grid>
   <Border Grid.Row="1" IsVisible="{Binding IsLibrary}" Classes="panel" Padding="18">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
     <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="XBOX LIBRARY" Classes="eyebrow"/><TextBlock Text="{Binding GameCount, StringFormat={}{0} titles}" Classes="muted" Margin="0,5,0,0"/></StackPanel><Button Grid.Column="1" Content="Refresh" Click="RefreshLibrary" IsEnabled="{Binding CanQuery}"/></Grid>
     <Grid Grid.Row="1" ColumnDefinitions="*,190"><TextBox Text="{Binding LibrarySearch, Mode=TwoWay}" PlaceholderText="Search Xbox games or title ID…"/><ComboBox Grid.Column="1" ItemsSource="{Binding PlatformFilters}" SelectedItem="{Binding PlatformFilter, Mode=TwoWay}" Margin="10,0,0,0"/></Grid>
     <ListBox Grid.Row="2" ItemsSource="{Binding VisibleGames}" SelectedItem="{Binding SelectedLibraryGame, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
      <ListBox.ItemTemplate><DataTemplate x:DataType="local:Game"><Grid ColumnDefinitions="64,*,150,110,150" Margin="10,8"><Grid Width="54" Height="54"><Border Background="#171A1C" CornerRadius="8"><TextBlock Text="{Binding Monogram}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/></Border><Border CornerRadius="8" ClipToBounds="True"><local:RemoteImage Url="{Binding ImageUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Spacing="6" Margin="10,0"><TextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Platform}" Classes="muted" FontSize="10"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding ProgressLabel}" VerticalAlignment="Center" Classes="muted"/><TextBlock Grid.Column="3" Text="{Binding Id}" VerticalAlignment="Center"/><StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right"><Button Content="Copy ID" Tag="{Binding}" Click="CopyTitleId" Padding="10,7"/><Button Content="Open" Tag="{Binding}" Click="OpenSelectedXboxGame" Padding="10,7" Classes="primary"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   <TabControl Grid.Row="1" IsVisible="{Binding IsTools}"><TabItem Header="Title search"><Grid RowDefinitions="Auto,Auto,*"><Grid ColumnDefinitions="*,Auto,Auto" Margin="0,12"><TextBox Text="{Binding TitleSearch, Mode=TwoWay}" PlaceholderText="Search by game title"/><Button Grid.Column="1" Content="Search titles" Click="SearchTitles" IsEnabled="{Binding CanInteract}" Margin="10,0,0,0"/><CheckBox Grid.Column="2" Content="Only verified achievements" IsChecked="{Binding OnlyVerifiedAchievementTitles, Mode=TwoWay}" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid><TextBlock Grid.Row="1" Text="{Binding LookupOutput}" Classes="muted" Margin="0,0,0,8"/><ListBox Grid.Row="2" ItemsSource="{Binding TitleSearchResults}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="local:TitleSearchResult"><Border Classes="panel" Padding="14" Margin="0,5"><Grid ColumnDefinitions="64,*,150,130" ColumnSpacing="14"><Grid Width="54" Height="54"><Border Background="#171A1C" CornerRadius="8"><TextBlock Text="{Binding Monogram}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/></Border><Border CornerRadius="8" ClipToBounds="True"><local:RemoteImage Url="{Binding ImageUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Platform}" Classes="muted"/><TextBlock Text="{Binding AchievementCatalogStatus}" Classes="muted" FontSize="10"/></StackPanel><StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="TITLE ID" Classes="eyebrow"/><TextBlock Text="{Binding TitleId}"/></StackPanel><StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center"><Button Content="Open achievements" Tag="{Binding}" Click="OpenSearchTitle"/><Button Content="Copy Title ID" Tag="{Binding}" Click="CopySearchTitleId"/><Button Content="Add GPD to profile" Tag="{Binding}" Click="AddTitleSearchGpd" IsVisible="{Binding CanAddXbox360Gpd}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem><TabItem Header="Profile lookup"><Grid RowDefinitions="Auto,*"><StackPanel Margin="0,12" Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding GamertagSearch, Mode=TwoWay}" PlaceholderText="Gamertag"/><Button Grid.Column="1" Content="Look up profile" Click="SearchGamertag" IsEnabled="{Binding CanQuery}"/></Grid><WrapPanel><CheckBox Content="Exclude zero-score games" IsChecked="{Binding ExcludeZeroScore, Mode=TwoWay}"/><CheckBox Content="Exclude Xbox 360" IsChecked="{Binding Exclude360, Mode=TwoWay}" Margin="14,0"/><Button Content="Export games CSV" Click="ExportProfileGames" IsEnabled="{Binding CanQuery}"/></WrapPanel></StackPanel><TextBox Grid.Row="1" Text="{Binding LookupOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/></Grid></TabItem><TabItem Header="Account"><StackPanel Spacing="14" Margin="20"><WrapPanel><Button Content="Refresh Xbox profile" Click="RefreshAccountProfile" IsEnabled="{Binding CanQuery}"/><Button Content="Show Steam profile" Click="ShowSteamProfile"/></WrapPanel><TextBox Text="{Binding AccountSummary}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel></TabItem><TabItem Header="Tools"><StackPanel Margin="20" Spacing="16"><TextBlock Text="{Binding ConverterStatus}" Classes="muted" TextWrapping="Wrap"/><WrapPanel><Button Content="Refresh converter status" Click="RefreshConverter"/><Button Content="Open Steam save-converter workspace" Tag="Steam converter" Click="OpenUtilityLink"/></WrapPanel><Button Content="Discord" Tag="Discord" Click="OpenUtilityLink"/></StackPanel></TabItem></TabControl>
   <TabControl Grid.Row="1" IsVisible="{Binding IsQueues}">
    <TabItem Header="Xbox"><Grid RowDefinitions="Auto,*,Auto" Margin="0,12">
     <StackPanel Spacing="12"><Grid ColumnDefinitions="*,*" IsEnabled="{Binding XboxQueue.IsConfigEnabled}"><TextBox Text="{Binding XboxQueue.ReferenceGamertag, Mode=TwoWay}" PlaceholderText="Reference gamertag"/><TextBox Grid.Column="1" Text="{Binding XboxQueue.TitleId, Mode=TwoWay}" PlaceholderText="Title ID" Margin="10,0,0,0"/></Grid><StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanQuery}"><Button Content="Build queue" Command="{Binding XboxQueue.BuildQueueCommand}"/><Button Content="Resume saved queue" Command="{Binding XboxQueue.ResumeExistingSessionCommand}"/><Button Content="Clear saved queue" Command="{Binding XboxQueue.ClearExistingSessionCommand}"/></StackPanel><TextBlock Text="Reference gaps receive up to ±1 minute of variation below one hour and up to ±5 minutes at one hour or longer. Simultaneous unlocks stay simultaneous. Edit any delay below before starting." TextWrapping="Wrap" Classes="muted"/><TextBlock Text="{Binding XboxQueue.StatusText}" TextWrapping="Wrap"/><TextBlock Text="{Binding XboxQueue.ProgressText}"/><TextBlock Text="{Binding XboxQueue.TimeRemainingText}"/></StackPanel>
     <ListBox Grid.Row="1" ItemsSource="{Binding XboxQueue.QueueItems}" Margin="0,15" IsEnabled="{Binding XboxQueue.IsConfigEnabled}"><ListBox.ItemTemplate><DataTemplate x:DataType="workflows:AutoUnlockerViewModel+AutoUnlockQueueDisplay"><Grid ColumnDefinitions="*,220,150" Margin="10"><TextBlock Text="{Binding AchievementName}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><NumericUpDown Value="{Binding DelayMinutes, Mode=TwoWay}" Minimum="0" Maximum="10080" Increment="0.5" Width="165" HorizontalContentAlignment="Left" IsEnabled="{Binding CanEditDelay}"/><TextBlock Text="min" VerticalAlignment="Center" Classes="muted"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10"><Button Content="{Binding XboxQueue.StartStopButtonText}" Click="RunXboxQueue"/><TextBlock Text="Speed multiplier" VerticalAlignment="Center"/><NumericUpDown Value="{Binding XboxQueue.SpeedMultiplier, Mode=TwoWay}" Minimum="0.1" Maximum="100" Increment="0.1" Width="130"/></StackPanel>
    </Grid></TabItem>
    <TabItem Header="Steam"><Grid RowDefinitions="Auto,*,Auto" Margin="0,12"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,*"><TextBox Text="{Binding SteamQueue.AppId, Mode=TwoWay}" PlaceholderText="Steam app ID"/><TextBox Grid.Column="1" Text="{Binding SteamQueue.TargetProfile, Mode=TwoWay}" PlaceholderText="Reference Steam profile" Margin="10,0,0,0"/></Grid><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Load locked achievements" Command="{Binding SteamQueue.LoadQueueCommand}"/><Button Content="Load profile queue" Command="{Binding SteamQueue.LoadProfileQueueCommand}"/><Button Content="Clear" Command="{Binding SteamQueue.ClearQueueCommand}"/></StackPanel><WrapPanel><TextBlock Text="Min delay (seconds)" VerticalAlignment="Center" Margin="0,0,8,0"/><NumericUpDown Value="{Binding SteamQueue.MinimumDelaySeconds, Mode=TwoWay}" Width="110"/><TextBlock Text="Max delay" VerticalAlignment="Center" Margin="12,0,8,0"/><NumericUpDown Value="{Binding SteamQueue.MaximumDelaySeconds, Mode=TwoWay}" Width="110"/><TextBlock Text="Profile time scale" VerticalAlignment="Center" Margin="12,0,8,0"/><NumericUpDown Value="{Binding SteamQueue.ProfileTimeScale, Mode=TwoWay}" Width="110"/></WrapPanel><TextBlock Text="{Binding SteamQueue.StatusText}" TextWrapping="Wrap"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding SteamQueue.QueueItems}" Margin="0,15"><ListBox.ItemTemplate><DataTemplate x:DataType="models:SteamAutoUnlockQueueItem"><Grid ColumnDefinitions="*,100,180" Margin="10"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding DelaySeconds}"/><TextBlock Grid.Column="2" Text="{Binding Status}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10"><Button Content="Start queue" Click="RunSteamQueue" IsEnabled="{Binding CanInteract}"/><Button Content="Stop" Command="{Binding SteamQueue.StopCommand}"/></StackPanel></Grid></TabItem>
   </TabControl>
     <Grid Grid.Row="1" IsVisible="{Binding IsXbox360Profiles}" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
      <TextBlock Text="Extract a profile from USB with a verified backup, then load the local working copy. The Xbox library stays combined; Open uses this profile for Xbox 360 games." TextWrapping="Wrap" Classes="muted"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="1. Extract USB profile and backup" Click="ExtractUsbProfile" IsEnabled="{Binding CanInteract}"/><Button Content="Open profiles folder" Click="OpenProfilesFolder"/><Button Content="Refresh local profiles" Click="RefreshLocalXbox360Profiles"/></StackPanel>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8"><ComboBox ItemsSource="{Binding LocalXbox360Profiles}" SelectedItem="{Binding SelectedLocalXbox360Profile, Mode=TwoWay}"/><Button Grid.Column="1" Content="2. Load selected profile" Click="LoadSelectedXbox360Profile" IsEnabled="{Binding CanInteract}"/></Grid>
      <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="16"><StackPanel Spacing="8"><TextBlock Text="Loaded profile" Classes="eyebrow"/><TextBlock Text="{Binding LoadedXbox360Profile}" TextWrapping="Wrap"/><TextBlock Text="{Binding UsbProfileStatus}" Classes="muted" TextWrapping="Wrap"/><Button Content="3. Inject loaded profile to USB" Click="InjectXbox360Profile" IsEnabled="{Binding CanInjectXbox360Profile}" HorizontalAlignment="Left"/><TextBlock Text="Injection creates a verified backup of the USB profile before replacing it." Classes="muted" TextWrapping="Wrap"/><Border Height="1" Background="#24272A" Margin="0,14"/><TextBlock Text="ADD GAME FROM GPD" Classes="eyebrow"/><TextBlock Text="{Binding GpdDirectory}" Classes="muted" TextWrapping="Wrap"/><Button Content="Open GPD catalog folder" Click="OpenGpdFolder" HorizontalAlignment="Left"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding GpdTitleId, Mode=TwoWay}" PlaceholderText="Xbox 360 title ID (hex or decimal)"/><Button Grid.Column="1" Content="Add GPD to loaded profile" Click="AddXbox360Gpd" IsEnabled="{Binding CanInteract}"/></Grid><TextBlock Text="{Binding GpdAddStatus}" Classes="muted" TextWrapping="Wrap"/></StackPanel><Grid Grid.Column="1" RowDefinitions="Auto,*"><TextBlock Text="Games in loaded profile" Classes="eyebrow"/><ListBox Grid.Row="1" ItemsSource="{Binding Xbox360Games}" SelectedItem="{Binding SelectedXbox360Game, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="models:Xbox360ProfileGame"><StackPanel Margin="5"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding TitleId}" Classes="muted"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Grid>
      <TextBlock Grid.Row="4" Text="{Binding LegacyOutput}" TextWrapping="Wrap" Classes="muted"/>
     </Grid>
     <Grid Grid.Row="1" IsVisible="{Binding IsXbox360ProfileEditor}" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
      <StackPanel Spacing="5"><TextBlock Text="{Binding Xbox360EditorTitleName}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding Xbox360EditorTitleId}" Classes="muted"/><TextBlock Text="{Binding LoadedXbox360Profile}" Classes="muted" TextWrapping="Wrap"/><Button Content="Manage Xbox 360 profile" Click="ShowXbox360Profiles" HorizontalAlignment="Left"/></StackPanel>
      <TextBlock Grid.Row="1" Text="Local Xbox 360 profile achievements" Classes="eyebrow"/>
      <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="14">
       <ListBox ItemsSource="{Binding Xbox360Achievements}" SelectedItem="{Binding SelectedXbox360Achievement, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="models:Xbox360ProfileAchievement"><Grid ColumnDefinitions="*,130,80" Margin="8"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted"/><TextBlock Grid.Column="2" Text="{Binding Gamerscore}" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
       <StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="{Binding SelectedXbox360Achievement.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedXbox360Achievement.Status}"/><TextBlock Text="{Binding SelectedXbox360Achievement.Gamerscore}"/><TextBlock Text="{Binding SelectedXbox360Achievement.UnlockedDescription}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedXbox360Achievement.LockedDescription}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedXbox360Achievement.UnlockedAt}" Classes="muted"/><TextBlock Text="Unlock state" Classes="eyebrow"/><ComboBox ItemsSource="{Binding Xbox360UnlockModes}" SelectedItem="{Binding Xbox360UnlockMode, Mode=TwoWay}"/><TextBlock Text="Unlock time (local, yyyy-MM-dd HH:mm:ss.fff)" Classes="eyebrow"/><TextBox Text="{Binding Xbox360UnlockTimeText, Mode=TwoWay}" IsEnabled="{Binding CanEditXbox360UnlockTime}"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Set" Click="SetXbox360Achievement"/><Button Content="Save working copy" Click="SaveXbox360Edits" IsEnabled="{Binding CanSaveXbox360Edits}" Classes="primary"/><Button Content="Inject to USB" Click="InjectXbox360Profile" IsEnabled="{Binding CanInjectXbox360Profile}"/><TextBlock Text="{Binding PendingXbox360EditCount, StringFormat='{}{0} pending edits'}" VerticalAlignment="Center" Classes="muted"/></StackPanel><TextBlock Text="Save signs and verifies the local profile with a pre-save backup. Inject creates and verifies a separate USB backup before replacing the profile." TextWrapping="Wrap" Classes="muted"/></StackPanel>
      </Grid>
      <TextBlock Grid.Row="3" Text="{Binding LegacyOutput}" TextWrapping="Wrap" Classes="muted"/>
     </Grid>
     <Grid Grid.Row="1" IsVisible="{Binding IsGfwl}" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" Margin="8,0">
      <StackPanel Spacing="4"><TextBlock Text="Games for Windows LIVE achievement manager" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedGfwlTitle.Name}" FontSize="16"/><TextBlock Text="Run the 32-bit GFWL game and sign in inside it, then select its process." Classes="muted" TextWrapping="Wrap"/></StackPanel>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><ComboBox ItemsSource="{Binding GfwlProcesses}" SelectedItem="{Binding SelectedGfwlProcess, Mode=TwoWay}" PlaceholderText="Select GFWL game process"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:GfwlProcessItem"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding ProcessId}" Classes="muted"/><TextBlock Text="{Binding Status}" Classes="muted"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><CheckBox Grid.Column="1" Content="Show all processes (compatibility mode)" IsChecked="{Binding ShowAllGfwlProcesses, Mode=TwoWay}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Select game process" Click="ScanGfwl" IsEnabled="{Binding CanInteract}"/></Grid>
      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="9"><Button Content="Connect to selected game" Click="InjectGfwl" IsEnabled="{Binding CanInteract}"/><Button Grid.Column="1" Content="Refresh achievements" Click="RefreshGfwlAchievements" IsEnabled="{Binding CanInteract}"/><Button Grid.Column="2" Content="Earn selected" Click="EarnGfwlAchievement" IsEnabled="{Binding CanEarnGfwlAchievement}"/><TextBox Grid.Column="3" Text="{Binding GfwlSearch, Mode=TwoWay}" PlaceholderText="Search achievement name or ID"/></Grid>
      <Grid Grid.Row="3" RowDefinitions="Auto,*"><Grid ColumnDefinitions="68,65,150,*,*" Margin="12,0"><TextBlock Text="ID" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="G" Classes="eyebrow"/><TextBlock Grid.Column="2" Text="TIME / STATE" Classes="eyebrow"/><TextBlock Grid.Column="3" Text="NAME" Classes="eyebrow"/><TextBlock Grid.Column="4" Text="DESCRIPTION" Classes="eyebrow"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding VisibleGfwlAchievements}" SelectedItem="{Binding SelectedGfwlAchievement, Mode=TwoWay}" DoubleTapped="EarnGfwlFromDoubleTap"><ListBox.ItemTemplate><DataTemplate x:DataType="gfwl:GfwlAchievement"><Grid ColumnDefinitions="68,65,150,*,*" Margin="9,7"><TextBlock Text="{Binding Id}"/><TextBlock Grid.Column="1" Text="{Binding Gamerscore}"/><TextBlock Grid.Column="2" Text="{Binding TimeText}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Grid.Column="4" Text="{Binding Description}" Classes="muted" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
      <Border Grid.Row="4" Classes="panel" Padding="12"><TextBlock Text="{Binding GfwlStatus}" TextWrapping="Wrap"/></Border>
     </Grid>
     <Grid Grid.Row="1" IsVisible="{Binding IsLegacy}" RowDefinitions="Auto,*,Auto">
     <Border Background="#142018" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12"><TextBlock Text="Coming Soon — Windows 8, Games for Windows Live, and Xbox 360 tools remain experimental and are still being expanded." TextWrapping="Wrap"/></Border>
     <TabControl Grid.Row="1" SelectedIndex="{Binding LegacyTabIndex, Mode=TwoWay}"><TabItem Header="Windows 8"><ScrollViewer><StackPanel Spacing="12" Margin="14">
     <TextBlock Text="Windows 8 achievements" FontSize="24"/>
     <TextBlock Text="Test legacy Windows 8 requests directly with your connected Xbox account. Start with the game closed; each submission is checked separately for a recorded unlock." TextWrapping="Wrap" Classes="muted"/>
     <Button Content="Use app Xbox session" Command="{Binding Windows8.UseAppSessionCommand}"/>
     <TextBlock Text="{Binding Windows8.AccountSummary}" TextWrapping="Wrap"/>
     <Expander Header="Optional community bridge fallback" IsExpanded="False"><StackPanel Spacing="8"><TextBlock Text="Only for comparing the community bridge route. Not required for direct testing." TextWrapping="Wrap" Classes="muted"/><Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding Windows8.BridgeStatePath, Mode=TwoWay}" PlaceholderText="Optional bridge_state.json path"/><Button Grid.Column="1" Content="Browse…" Click="ChooseWindows8State"/><Button Grid.Column="2" Content="Import bridge session" Command="{Binding Windows8.LoadSessionCommand}"/></Grid></StackPanel></Expander>
     <ComboBox ItemsSource="{Binding Windows8.Titles}" SelectedItem="{Binding Windows8.SelectedTitle, Mode=TwoWay}" PlaceholderText="Choose a Windows 8 title, or enter its ID below"/>
     <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding Windows8.TitleId, Mode=TwoWay}" PlaceholderText="Windows 8 title ID"/><Button Grid.Column="1" Content="Load achievements" Command="{Binding Windows8.LoadAchievementsCommand}"/></Grid>
     <Grid ColumnDefinitions="*,150"><TextBox Text="{Binding Windows8.Search, Mode=TwoWay}" PlaceholderText="Search achievement name or ID"/><ComboBox Grid.Column="1" ItemsSource="{Binding Windows8.StateFilters}" SelectedItem="{Binding Windows8.StateFilter, Mode=TwoWay}" Margin="8,0,0,0"/></Grid>
     <TextBlock Text="{Binding Windows8.AchievementSummary}" Classes="muted"/>
     <ListBox Height="220" ItemsSource="{Binding Windows8.VisibleAchievements}" SelectedItem="{Binding Windows8.SelectedAchievement, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="workflows:Windows8Achievement"><Grid ColumnDefinitions="70,*,100" Margin="8"><TextBlock Text="{Binding Id}"/><TextBlock Grid.Column="1" Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Grid.Column="2" Text="{Binding State}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
     <Button Content="Submit selected and verify" Command="{Binding Windows8.SubmitSelectedCommand}" Classes="primary"/>
     <TextBlock Text="{Binding Windows8.Status}" TextWrapping="Wrap"/>
     <TextBlock Text="A successful sign-in does not guarantee permission to submit for every title. Games with local achievement queues may still require in-game synchronization; a rejected direct request alone does not establish that requirement." TextWrapping="Wrap" Classes="muted"/>
    </StackPanel></ScrollViewer></TabItem><TabItem Header="Advanced legacy diagnostics"><ScrollViewer MaxHeight="420"><StackPanel Spacing="10" Margin="10">
<ComboBox ItemsSource="{Binding LegacyBridge.TitleProfileNames}" SelectedItem="{Binding LegacyBridge.SelectedTitleProfileName, Mode=TwoWay}"/>
<Grid ColumnDefinitions="*,*,*"><TextBox Text="{Binding LegacyBridge.Xuid, Mode=TwoWay}" PlaceholderText="XUID"/><TextBox Grid.Column="1" Text="{Binding LegacyBridge.TitleId, Mode=TwoWay}" PlaceholderText="Title ID" Margin="8,0"/><TextBox Grid.Column="2" Text="{Binding LegacyBridge.AchievementId, Mode=TwoWay}" PlaceholderText="Achievement ID"/></Grid>
<TextBox Text="{Binding LegacyBridge.AuthorizationHeader, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Authorization header"/><TextBox Text="{Binding LegacyBridge.MsaAccessToken, Mode=TwoWay}" PasswordChar="●" PlaceholderText="MSA access token"/>
<ComboBox ItemsSource="{Binding LegacyBridge.RequestModeNames}" SelectedItem="{Binding LegacyBridge.SelectedRequestModeName, Mode=TwoWay}"/>
<Grid ColumnDefinitions="*,*,*"><TextBox Text="{Binding LegacyBridge.UnlockDate, Mode=TwoWay}" PlaceholderText="UTC date"/><TextBox Grid.Column="1" Text="{Binding LegacyBridge.UnlockTime, Mode=TwoWay}" PlaceholderText="UTC time" Margin="8,0"/><NumericUpDown Grid.Column="2" Value="{Binding LegacyBridge.AchievementPlatform, Mode=TwoWay}"/></Grid>
<WrapPanel><Button Margin="0,0,8,8" Content="Refresh preview" Command="{Binding LegacyBridge.RefreshPreviewCommand}"/><Button Margin="0,0,8,8" Content="Read profile achievements" Command="{Binding LegacyBridge.ReadProfileAchievementsCommand}"/><Button Margin="0,0,8,8" Content="Signed Win8 bridge" Command="{Binding LegacyBridge.UseSignedWin8BridgeCommand}"/><Button Margin="0,0,8,8" Content="Convert MSA token" Command="{Binding LegacyBridge.ConvertMsaTokenCommand}"/><Button Margin="0,0,8,8" Content="Signed Win32 bridge" Command="{Binding LegacyBridge.UseSignedWin32BridgeCommand}"/><Button Margin="0,0,8,8" Content="MSA bridge" Command="{Binding LegacyBridge.UseAchievementLabsMsaBridgeCommand}"/><Button Margin="0,0,8,8" Content="Fetch local ticket" Command="{Binding LegacyBridge.FetchLocalTicketCommand}"/><Button Margin="0,0,8,8" Content="Use current session" Command="{Binding LegacyBridge.UseCurrentAchievementLabsSessionCommand}"/><Button Margin="0,0,8,8" Content="Read progress catalog" Command="{Binding LegacyBridge.ReadProgressCatalogCommand}"/><Button Margin="0,0,8,8" Content="Send range" Command="{Binding LegacyBridge.SendRangeUnlockCommand}"/><Button Margin="0,0,8,8" Content="Probe devices" Command="{Binding LegacyBridge.ProbeSignedDevicesCommand}"/><Button Margin="0,0,8,8" Content="Send selected" Command="{Binding LegacyBridge.SendSingleUnlockCommand}"/></WrapPanel><Grid ColumnDefinitions="*,*,*"><NumericUpDown Value="{Binding LegacyBridge.RangeStart, Mode=TwoWay}"/><NumericUpDown Grid.Column="1" Value="{Binding LegacyBridge.RangeEnd, Mode=TwoWay}" Margin="8,0"/><NumericUpDown Grid.Column="2" Value="{Binding LegacyBridge.RangeDelayMilliseconds, Mode=TwoWay}"/></Grid><TextBlock Text="{Binding LegacyBridge.StatusText}" TextWrapping="Wrap"/><TextBox Text="{Binding LegacyBridge.RequestPreview}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="120"/><TextBox Text="{Binding LegacyBridge.LastResponseDetails}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Height="120"/></StackPanel></ScrollViewer></TabItem><TabItem Header="Windows saves"><StackPanel Spacing="10" Margin="10"><ComboBox ItemsSource="{Binding Win8Tools.GameNames}" SelectedItem="{Binding Win8Tools.SelectedGameName, Mode=TwoWay}"/><Grid ColumnDefinitions="*,*"><TextBox Text="{Binding Win8Tools.Xuid, Mode=TwoWay}" PlaceholderText="Xbox user ID"/><TextBox Grid.Column="1" Text="{Binding Win8Tools.SelectedAchievementId, Mode=TwoWay}" PlaceholderText="Achievement ID" Margin="10,0,0,0"/></Grid><WrapPanel><Button Content="Use signed-in user" Command="{Binding Win8Tools.UseAchievementLabsXuidCommand}"/><Button Content="Read save" Command="{Binding Win8Tools.RefreshCommand}"/><Button Content="Back up" Command="{Binding Win8Tools.BackupSaveCommand}"/><Button Content="Prepare selected" Command="{Binding Win8Tools.PrepareSelectedCommand}"/><Button Content="Prepare all" Command="{Binding Win8Tools.PrepareAllCommand}"/><Button Content="Submit selected in game" Command="{Binding Win8Tools.SubmitRuntimeSelectedCommand}"/><Button Content="Submit all in game" Command="{Binding Win8Tools.SubmitRuntimeAllCommand}"/><Button Content="Copy report" Command="{Binding Win8Tools.CopyReportCommand}"/></WrapPanel><TextBlock Text="{Binding Win8Tools.SavePath}" TextWrapping="Wrap"/><TextBlock Text="{Binding Win8Tools.StatusText}" TextWrapping="Wrap"/><TextBlock Text="{Binding Win8Tools.SummaryText}" TextWrapping="Wrap"/><ListBox ItemsSource="{Binding Win8Tools.Achievements}" Height="200"><ListBox.ItemTemplate><DataTemplate x:DataType="workflows:Win8SaveAchievementRow"><Grid ColumnDefinitions="50,*,100"><TextBlock Text="{Binding Id}"/><TextBlock Grid.Column="1" Text="{Binding Name}"/><TextBlock Grid.Column="2" Text="{Binding StatusText}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></StackPanel></TabItem>
     <TabItem Header="Xbox 360 profile"><Grid RowDefinitions="Auto,Auto,Auto,*" Margin="10" RowSpacing="10">
       <TextBlock Text="{Binding UsbProfileStatus}" TextWrapping="Wrap"/>
       <WrapPanel Grid.Row="1"><Button Content="Extract USB profile and backup" Click="ExtractUsbProfile" IsEnabled="{Binding CanInteract}"/><Button Content="Open extracted profiles" Click="OpenProfilesFolder"/></WrapPanel>
       <Grid Grid.Row="2" ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8"><TextBox Text="{Binding PackagePath, Mode=TwoWay}" PlaceholderText="Xbox 360 profile package"/><Button Grid.Column="1" Content="Browse…" Click="ChoosePackage"/><Button Grid.Column="2" Content="Read profile" Click="LoadXbox360Profile" IsEnabled="{Binding CanInteract}"/><Button Grid.Column="3" Content="Inspect package" Click="InspectPackage" IsEnabled="{Binding CanInteract}"/></Grid>
       <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="12">
        <Grid RowDefinitions="Auto,*" RowSpacing="6"><TextBlock Text="Games" FontWeight="SemiBold"/><ListBox Grid.Row="1" ItemsSource="{Binding Xbox360Games}" SelectedItem="{Binding SelectedXbox360Game, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="models:Xbox360ProfileGame"><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding TitleId}" Classes="muted"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
        <Grid Grid.Column="1" RowDefinitions="Auto,*" RowSpacing="6"><Button Content="Read selected game's achievements" Click="LoadXbox360Achievements" IsEnabled="{Binding CanInteract}"/><ListBox Grid.Row="1" ItemsSource="{Binding Xbox360Achievements}"><ListBox.ItemTemplate><DataTemplate x:DataType="models:Xbox360ProfileAchievement"><StackPanel Margin="4"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding Status}" Classes="muted"/><TextBlock Text="{Binding Gamerscore}" Classes="muted"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
       </Grid>
      </Grid></TabItem>
     <TabItem Header="GFWL"><StackPanel Spacing="12" Margin="10"><TextBlock Text="Games for Windows LIVE" FontSize="24"/><TextBlock Text="{Binding SelectedGfwlTitle.Name}" FontSize="16"/><TextBlock Text="{Binding SelectedGfwlTitle.Description}" Classes="muted"/><TextBlock Text="Start this PC title, then scan for its GFWL runtime. Xbox 360 USB profile editing does not apply to this title." TextWrapping="Wrap" Classes="muted"/><ComboBox ItemsSource="{Binding GfwlProcesses}" SelectedItem="{Binding SelectedGfwlProcess, Mode=TwoWay}"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:GfwlProcessItem"><StackPanel Orientation="Horizontal" Spacing="12"><TextBlock Text="{Binding ProcessId}"/><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Status}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><StackPanel Orientation="Horizontal" Spacing="8" IsEnabled="{Binding CanInteract}"><Button Content="Scan processes" Click="ScanGfwl"/><Button Content="Launch achievement adapter" Click="InjectGfwl"/></StackPanel></StackPanel></TabItem>
     </TabControl><TextBox Grid.Row="2" Text="{Binding LegacyOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" Margin="0,20,0,0"/>
   </Grid>
    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsAbout}"><StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Left"><Image Source="/Assets/achievement-labs-logo.png" Width="86" Height="86" HorizontalAlignment="Left"/><TextBlock Text="Achievement Labs" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Achievement Labs is a unified desktop workspace for viewing and managing achievements across Xbox, Steam, and legacy PC ecosystems. It combines account-aware libraries, achievement tools, title research, and community-tested compatibility in a native Avalonia interface." TextWrapping="Wrap" LineHeight="22"/><TextBlock Text="Achievement Labs builds on the original Ultimate Xbox Achievement Unlocker (XAU) project. Credit and thanks go to ItsLogic and the original contributors whose work made this project possible." TextWrapping="Wrap" Classes="muted" LineHeight="21"/><WrapPanel><Button Content="Achievement Labs on GitHub" Tag="GitHub" Click="OpenUtilityLink"/><Button Content="Original XAU project" Tag="Original XAU" Click="OpenUtilityLink" Margin="8,0,0,0"/><Button Content="Join Discord" Tag="Discord" Click="OpenUtilityLink" Margin="8,0,0,0"/></WrapPanel></StackPanel></ScrollViewer>
   <Border Grid.Row="1" IsVisible="{Binding IsSteamLibrary}" Classes="panel" Padding="18">
    <Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding SteamSearch, Mode=TwoWay}" PlaceholderText="Search Steam games or app ID…"/><Button Grid.Column="1" Content="Refresh library" Click="ShowSteam" IsEnabled="{Binding CanInteract}" Margin="10,0,0,0"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding SteamGames}" SelectedItem="{Binding SelectedSteamGame, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="models:SteamGameItem"><Grid ColumnDefinitions="64,*,120,150" Margin="10,8"><Grid Width="54" Height="54"><Border Background="#171A1C" CornerRadius="8"/><local:RemoteImage Url="{Binding ImageUrl}" Stretch="UniformToFill"/></Grid><StackPanel Grid.Column="1" Spacing="6" Margin="10,0"><TextBlock Text="{Binding DisplayName}" FontSize="15"/><TextBlock Text="{Binding Status}" Classes="muted" FontSize="10"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding AppId}" VerticalAlignment="Center"/><Button Grid.Column="3" Content="Open achievements" Tag="{Binding}" Click="OpenSteamAchievements" Classes="primary"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   </Border>
   <Grid Grid.Row="1" IsVisible="{Binding IsSteamAchievements}" RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding SteamAppId, Mode=TwoWay}" PlaceholderText="Open Steam achievements by app ID…"/><Button Grid.Column="1" Content="Load achievements" Click="LoadSteam" IsEnabled="{Binding CanInteract}" Margin="10,0,0,0"/></Grid><TextBlock Text="{Binding SteamStatus}" TextWrapping="Wrap"/><TextBox Text="{Binding SteamAchievementSearch, Mode=TwoWay}" PlaceholderText="Search achievements by name or ID…"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12"><Button Content="Select all" Click="SelectAllSteam" IsEnabled="{Binding CanInteract}"/><Button Content="Clear all" Click="ClearAllSteam" IsEnabled="{Binding CanInteract}"/><Button Content="Invert" Click="InvertSteam"/><Button Content="Revert" Click="RevertSteam"/><Button Content="Save changes" Click="SaveSteam" IsEnabled="{Binding CanInteract}" Classes="primary"/></StackPanel>
    <ListBox Grid.Row="2" ItemsSource="{Binding VisibleSteamAchievements}" IsEnabled="{Binding CanInteract}"><ListBox.ItemTemplate><DataTemplate x:DataType="models:SteamAchievementItem"><Grid ColumnDefinitions="40,*" Margin="8"><CheckBox IsChecked="{Binding DesiredUnlocked, Mode=TwoWay}"/><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Id}" Classes="muted" FontSize="11"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="muted"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"><Button Content="Start presence" Click="StartSteamPresence" IsEnabled="{Binding CanInteract}"/><Button Content="Stop presence" Click="StopSteamPresence"/><Button Content="Reset stats" Click="ResetSteamStats" IsEnabled="{Binding CanInteract}"/><Button Content="Refresh metadata" Click="RefreshSteamMetadata" IsEnabled="{Binding CanInteract}"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" IsVisible="{Binding IsPlatform}" RowDefinitions="Auto,*">
    <Border IsVisible="{Binding IsEpic}" Background="#17140A" BorderBrush="#A88622" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"><TextBlock Text="Epic Games features are still in development and are not finalized. Compatibility and behavior may change." Foreground="#E1CA7A" TextWrapping="Wrap"/></Border>
    <Border IsVisible="{Binding IsUbisoft}" Background="#17140A" BorderBrush="#A88622" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"><TextBlock Text="Ubisoft features are still in development and are not finalized. The data tools and injector may have limited compatibility and may change." Foreground="#E1CA7A" TextWrapping="Wrap"/></Border>
    <Grid Grid.Row="1" ColumnDefinitions="290,*">
     <Grid RowDefinitions="Auto,*,Auto" Margin="0,0,20,0"><TextBox Text="{Binding PlatformSearch, Mode=TwoWay}" PlaceholderText="Search installed titles…"/><ListBox Grid.Row="1" ItemsSource="{Binding PlatformTitles}" SelectedItem="{Binding SelectedPlatformTitle, Mode=TwoWay}" Margin="0,12"><ListBox.ItemTemplate><DataTemplate x:DataType="local:PlatformTitle"><StackPanel Spacing="6" Margin="6"><TextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Id}" Classes="muted" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="Refresh" Click="RefreshPlatform" IsEnabled="{Binding CanInteract}"/><Button Content="Copy context" Click="CopyPlatformContext"/><Button Content="Folder" Click="OpenPlatformFolder"/></StackPanel></Grid>
     <TabControl Grid.Column="1"><TabItem Header="Title data"><Grid RowDefinitions="Auto,*"><ComboBox ItemsSource="{Binding PlatformSections}" SelectedItem="{Binding PlatformSection, Mode=TwoWay}" IsVisible="{Binding IsUbisoft}" Margin="0,10"/><ListBox Grid.Row="1" ItemsSource="{Binding PlatformDetails}" SelectedItem="{Binding SelectedPlatformDetail, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="local:PlatformDetail"><StackPanel Spacing="6" Margin="10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Id}" Classes="muted"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/><TextBlock Text="{Binding State}" Classes="muted" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
     <TabItem Header="Configuration"><ScrollViewer><StackPanel Spacing="14" Margin="20">
      <StackPanel IsVisible="{Binding IsEpic}" Spacing="10"><TextBlock Text="Epic EOS configuration" FontSize="20"/>
       <TextBox Text="{Binding EpicConfig.ProductId, Mode=TwoWay}" PlaceholderText="Product ID"/><TextBox Text="{Binding EpicConfig.SandboxId, Mode=TwoWay}" PlaceholderText="Sandbox ID"/><TextBox Text="{Binding EpicConfig.DeploymentId, Mode=TwoWay}" PlaceholderText="Deployment ID"/><TextBox Text="{Binding EpicConfig.ClientId, Mode=TwoWay}" PlaceholderText="Client ID"/><TextBox Text="{Binding EpicConfig.ClientSecret, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Client secret"/><TextBox Text="{Binding EpicConfig.EncryptionKey, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Encryption key"/><TextBox Text="{Binding EpicConfig.CaptureFolder, Mode=TwoWay}" PlaceholderText="Capture folder"/>
      </StackPanel>
      <StackPanel IsVisible="{Binding IsUbisoft}" Spacing="10"><TextBlock Text="Ubisoft configuration" FontSize="20"/>
       <TextBox Text="{Binding UbisoftConfig.ClientId, Mode=TwoWay}" PlaceholderText="Client ID"/><TextBox Text="{Binding UbisoftConfig.ClientSecret, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Client secret"/><TextBox Text="{Binding UbisoftConfig.SessionTicket, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Session ticket"/><TextBox Text="{Binding UbisoftConfig.SpaceId, Mode=TwoWay}" PlaceholderText="Space ID"/><TextBox Text="{Binding UbisoftConfig.Environment, Mode=TwoWay}" PlaceholderText="Environment"/><TextBox Text="{Binding UbisoftConfig.CaptureFolder, Mode=TwoWay}" PlaceholderText="Capture folder"/>
      </StackPanel><WrapPanel><Button Content="Save configuration" Click="SavePlatformConfig"/><Button Content="Open captures" Click="OpenPlatformCaptures"/><Button Content="Copy selected data" Click="CopyPlatformDetail"/></WrapPanel>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Achievement injector" IsVisible="{Binding IsUbisoft}"><Grid ColumnDefinitions="*,360" ColumnSpacing="18" Margin="16"><Grid RowDefinitions="Auto,*"><TextBox Text="{Binding PlatformSearch, Mode=TwoWay}" PlaceholderText="Filter Ubisoft spool catalog…"/><ListBox Grid.Row="1" ItemsSource="{Binding UbisoftSpools}" SelectedItem="{Binding SelectedUbisoftSpool, Mode=TwoWay}" Margin="0,12"><ListBox.ItemTemplate><DataTemplate x:DataType="local:UbisoftSpoolItem"><StackPanel Margin="8" Spacing="4"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding RelativePath}" Classes="muted" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid><ScrollViewer Grid.Column="1"><StackPanel Spacing="14"><TextBlock Text="SPOOL INSTALLER" Classes="eyebrow"/><TextBlock Text="Copies the selected .spool file into the Ubisoft achievement cache. Existing files are timestamp-backed up." Classes="muted" TextWrapping="Wrap"/><TextBox Text="{Binding UbisoftSpoolTarget, Mode=TwoWay}" PlaceholderText="Ubisoft achievement spool folder"/><Button Content="Choose spool folder" Click="ChooseUbisoftSpoolFolder"/><Button Content="Install selected spool" Click="InstallUbisoftSpool" Classes="primary"/><Border Height="1" Background="{DynamicResource Line}" Margin="0,8"/><TextBlock Text="OVERLAY TOOL" Classes="eyebrow"/><TextBlock Text="Installs the supplied Steam006 overlay tool into a selected game folder and retains the original Ubisoft overlay DLL." Classes="muted" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding UbisoftOverlayArchitectures}" SelectedItem="{Binding UbisoftOverlayArchitecture, Mode=TwoWay}"/><TextBox Text="{Binding UbisoftOverlayTarget, Mode=TwoWay}" PlaceholderText="Ubisoft game overlay folder"/><Button Content="Choose game folder" Click="ChooseUbisoftOverlayFolder"/><Button Content="Install overlay tool" Click="InstallUbisoftOverlay"/><TextBlock Text="{Binding UbisoftToolStatus}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid></TabItem>
     </TabControl>
    </Grid>
   </Grid>
   <Grid Grid.Row="1" IsVisible="{Binding IsSpoofer}" RowDefinitions="Auto,*" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding PresenceTitleId, Mode=TwoWay}" PlaceholderText="Xbox title ID"/><Button Grid.Column="1" Content="Look up title" Click="LookupSpoofTitle" IsEnabled="{Binding CanQuery}" Margin="10,0"/><Button Grid.Column="2" Content="{Binding PresenceRunning, StringFormat={}{0}}" IsVisible="False"/></Grid>
     <Border Grid.Row="1" Classes="panel" Padding="24"><Grid ColumnDefinitions="300,*,220" ColumnSpacing="24"><Grid><Border Background="#0E1110" CornerRadius="10"/><local:RemoteImage Url="{Binding SpoofTitleImageUrl}" Stretch="UniformToFill"/></Grid><StackPanel Grid.Column="1" Spacing="14"><TextBlock Text="SPOOFED TITLE" Classes="eyebrow"/><TextBlock Text="{Binding SpoofTitleName}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SpoofTitleDetails}" Classes="muted" TextWrapping="Wrap" LineHeight="22"/><TextBlock Text="{Binding StatsOutput}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="2" Spacing="12"><TextBlock Text="PRESENCE" Classes="eyebrow"/><TextBlock Text="{Binding SpoofingStatus}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"/><Button Content="Start spoofing" Click="StartPresence" IsEnabled="{Binding CanQuery}" Classes="primary"/><Button Content="Stop spoofing" Click="StopPresence" IsEnabled="{Binding PresenceRunning}"/></StackPanel></Grid></Border>
   </Grid>
   <Grid Grid.Row="1" IsVisible="{Binding IsStats}" RowDefinitions="Auto,*">
    <Border Classes="panel" Padding="24"><StackPanel Spacing="14"><TextBlock Text="Game statistics" FontSize="24"/>
     <Grid ColumnDefinitions="*,*,Auto"><TextBox Text="{Binding StatsTitleId, Mode=TwoWay}" PlaceholderText="Title ID"/><TextBox Grid.Column="1" Text="{Binding ServiceConfigId, Mode=TwoWay}" PlaceholderText="Service configuration ID (optional for reads)" Margin="10,0"/><Button Grid.Column="2" Content="Read stats" Click="ReadStats" IsEnabled="{Binding CanQuery}"/></Grid>
     <Grid ColumnDefinitions="*,*,Auto"><TextBox Text="{Binding StatName, Mode=TwoWay}" PlaceholderText="Stat name"/><TextBox Grid.Column="1" Text="{Binding StatValue, Mode=TwoWay}" PlaceholderText="JSON value" Margin="10,0"/><Button Grid.Column="2" Content="Write stat" Click="WriteStat" IsEnabled="{Binding CanQuery}"/></Grid>
     <Button Content="Use selected achievement title" Click="UseStatsTitle"/>
<Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding PresenceTitleId, Mode=TwoWay}" PlaceholderText="Title ID for presence"/><Button Grid.Column="1" Content="Start presence" Click="StartPresence" IsEnabled="{Binding CanQuery}" Margin="10,0"/><Button Grid.Column="2" Content="Stop presence" Click="StopPresence" IsEnabled="{Binding PresenceRunning}"/></Grid>
    </StackPanel></Border>
    <TabControl Grid.Row="1" Margin="0,15,0,0"><TabItem Header="Discovered stats"><Grid RowDefinitions="Auto,*"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding StatsEditor.TitleId, Mode=TwoWay}" PlaceholderText="Title ID"/><Button Grid.Column="1" Content="Load stats" Command="{Binding StatsEditor.LoadStatsCommand}" IsEnabled="{Binding CanQuery}"/></Grid><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save discovered stats" Command="{Binding StatsEditor.SaveDiscoveredStatsCommand}"/><Button Content="Update changed stats" Command="{Binding StatsEditor.UpdateAllStatsCommand}" IsEnabled="{Binding CanQuery}"/></StackPanel><TextBlock Text="{Binding StatsEditor.StatusText}" TextWrapping="Wrap"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding StatsEditor.StatItems}"><ListBox.ItemTemplate><DataTemplate x:DataType="workflows:StatsEditorViewModel+StatDisplayItem"><Grid ColumnDefinitions="*,100,140,Auto" Margin="8"><StackPanel><TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" Classes="muted"/><TextBlock Text="{Binding EditStatus}" Classes="muted"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding CurrentValue}"/><TextBox Grid.Column="2" Text="{Binding NewValue, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"/><Button Grid.Column="3" Content="Set" Tag="{Binding}" Click="SetDiscoveredStat" IsEnabled="{Binding IsEditable}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem><TabItem Header="Raw response"><TextBox Text="{Binding StatsOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/></TabItem></TabControl>
   </Grid>
   <ScrollViewer Grid.Row="1" IsVisible="{Binding IsSettings}">
    <StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Stretch">
     <Border Classes="panel" Padding="24"><StackPanel Spacing="16">
      <TextBlock Text="Workspace" FontSize="22"/>
      <TextBlock Text="Events folder"/>
      <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding EventsDirectory, Mode=TwoWay}"/><Button Grid.Column="1" Content="Browse…" Click="ChooseEvents" Margin="10,0,0,0"/></Grid>
      <TextBlock Text="Saved Xbox session file"/>
      <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding SessionPath, Mode=TwoWay}"/><Button Grid.Column="1" Content="Browse…" Click="ChooseSession" Margin="10,0,0,0"/></Grid>
      <CheckBox Content="Region override (applies on next connection)" IsChecked="{Binding RegionOverride, Mode=TwoWay}"/>
      <Border Classes="panel" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Event token" FontSize="18"/><TextBlock Text="Paste a current Xbox events token here. It is encrypted for this Windows user and checked before every event-based unlock." Classes="muted" TextWrapping="Wrap"/><TextBox Text="{Binding EventTokenInput, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Paste event token"/><TextBlock Text="{Binding EventTokenStatus}" Classes="muted" TextWrapping="Wrap"/><WrapPanel><Button Content="Save event token" Click="SaveEventToken" Classes="primary"/><Button Content="Remove saved token" Click="ClearEventToken"/></WrapPanel></StackPanel></Border>
      <CheckBox Content="Enable unlock-all for title-based achievements" IsChecked="{Binding UnlockAllEnabled, Mode=TwoWay}"/><CheckBox Content="Automatic title presence while viewing achievements" IsChecked="{Binding AutoSpoof, Mode=TwoWay}"/><CheckBox Content="Launch Xbox app at startup" IsChecked="{Binding AutoLaunchXboxApp, Mode=TwoWay}"/><CheckBox Content="Launch Xbox app hidden" IsChecked="{Binding LaunchXboxAppHidden, Mode=TwoWay}"/><CheckBox Content="Fake signature compatibility" IsChecked="{Binding FakeSignature, Mode=TwoWay}"/><CheckBox Content="Privacy mode" IsChecked="{Binding PrivacyMode, Mode=TwoWay}"/>
<CheckBox Content="Mint accent" IsChecked="{Binding MintAccent, Mode=TwoWay}"/>
      <Button Classes="primary" Content="Save settings" Click="SaveSettings"/>
     </StackPanel></Border>
     <Border Classes="panel" Padding="24"><StackPanel Spacing="14">
      <Border Classes="panel" Padding="14"><TextBlock Text="Legacy local API disabled: unauthenticated account and token export is not available." TextWrapping="Wrap" Classes="muted"/></Border>
<TextBlock Text="Xbox account" FontSize="22"/><TextBlock Text="{Binding ProfileName}"/>
      <TextBlock Text="Achievement Labs first attaches to the account already signed in to the Xbox PC app. No browser or pasted link is needed for this method." TextWrapping="Wrap" Classes="muted"/>
      <Border Classes="panel" Padding="16"><StackPanel Spacing="9"><TextBlock Text="{Binding XboxPcAttachmentLabel}" Foreground="#91CFB1" FontWeight="SemiBold"/><TextBlock Text="{Binding XboxPcAttachmentDetail}" Classes="muted" TextWrapping="Wrap"/><WrapPanel><Button Content="Attach to Xbox PC app" Click="ConnectXbox" IsEnabled="{Binding CanConnect}" Classes="primary"/><Button Content="Open Xbox app and retry" Click="LaunchXboxAndAttach" IsEnabled="{Binding CanConnect}" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border>
      <Border Classes="panel" Padding="16" IsVisible="{Binding OAuthFallbackAvailable}"><StackPanel Spacing="10"><TextBlock Text="Microsoft OAuth fallback" FontSize="18"/><TextBlock Text="Use this only when Xbox PC app attachment fails. Try a protected saved sign-in first. For a new sign-in, copy the final login.live.com address and use the single paste-and-finish button." TextWrapping="Wrap" Classes="muted"/><Button Content="Use saved OAuth fallback" Click="ConnectSavedOAuth" IsEnabled="{Binding CanConnect}"/><ComboBox ItemsSource="{Binding OAuthProfiles}" SelectedItem="{Binding OAuthProfile, Mode=TwoWay}"/><Button Content="Open Microsoft sign-in" Click="StartBrowserLogin" IsEnabled="{Binding CanConnect}"/><TextBox Text="{Binding LoginRedirect, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Final login.live.com redirect URL"/><CheckBox Content="Remember this fallback sign-in for this Windows user" IsChecked="{Binding RememberBrowserSession, Mode=TwoWay}"/><WrapPanel><Button Content="Paste copied address and finish" Click="PasteAndCompleteBrowserLogin" IsEnabled="{Binding CanConnect}" Classes="primary"/><Button Content="Complete typed OAuth sign-in" Click="CompleteBrowserLogin" IsEnabled="{Binding CanConnect}" Margin="8,0,0,0"/></WrapPanel><Expander Header="Advanced: manual authorization"><StackPanel Spacing="10"><TextBox Text="{Binding ManualAuthorization, Mode=TwoWay}" PasswordChar="●" PlaceholderText="XBL3.0 authorization"/><Button Content="Attach manual authorization" Click="AttachManual" IsEnabled="{Binding CanConnect}"/></StackPanel></Expander></StackPanel></Border>
<WrapPanel><Button Content="Disconnect" Click="Disconnect" IsEnabled="{Binding CanDisconnect}"/><Button Content="Forget saved native sign-in" Click="ForgetSavedSession" IsEnabled="{Binding CanConnect}"/></WrapPanel>
      <TextBlock Text="Disconnecting keeps the saved session file. Native preferences are saved separately from the existing app's settings." TextWrapping="Wrap" Classes="muted"/>
     </StackPanel></Border>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="1" IsVisible="{Binding IsDiagnostics}" RowDefinitions="Auto,Auto,*">
    <Border Classes="panel" Padding="24"><StackPanel Spacing="12"><TextBlock Text="Event catalog integrity" FontSize="24"/><TextBlock Text="Check title blocks, supported IDs, and standalone template files. This inspection does not modify the catalog." TextWrapping="Wrap" Classes="muted"/><TextBlock Text="{Binding EventsDirectory}" TextWrapping="Wrap"/><WrapPanel><Button Content="Inspect catalog" Click="InspectCatalog" IsEnabled="{Binding CanInteract}"/><Button Content="Test event replacements" Click="TestEventReplacements" IsEnabled="{Binding CanInteract}" Margin="10,0"/></WrapPanel></StackPanel></Border>
    <TextBlock Grid.Row="1" Text="{Binding CatalogSummary}" Margin="0,18" TextWrapping="Wrap"/>
    <ListBox Grid.Row="2" ItemsSource="{Binding CatalogFindings}" Background="Transparent"><ListBox.ItemTemplate><DataTemplate x:DataType="core:CatalogFinding"><Grid ColumnDefinitions="120,170,*" Margin="10"><TextBlock Text="{Binding TitleId}"/><TextBlock Grid.Column="1" Text="{Binding Status}"/><TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" Classes="muted"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid>
  </Grid><Border Grid.Row="1" Grid.Column="1" Background="#050606" BorderBrush="#24272A" BorderThickness="0,1,0,0" Padding="24,0"><Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"><TextBlock Text="{Binding Notice}" Classes="muted" FontSize="10"/><TextBlock Grid.Column="1" Text="AL  /  NATIVE DEVELOPMENT" FontSize="9" LetterSpacing="1" Foreground="#747B87"/></Grid></Border>
 </Grid>
</Window>
