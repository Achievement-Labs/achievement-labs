<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="using:AchievementLabs.Desktop" xmlns:workflows="using:AchievementLabs.Desktop.Workflows" xmlns:models="clr-namespace:AchievementLabs.Models;assembly=AchievementLabs.Core" xmlns:gfwl="clr-namespace:AchievementLabs.Services.Gfwl;assembly=AchievementLabs.Core" xmlns:core="clr-namespace:AchievementLabs.Core;assembly=AchievementLabs.Core" xmlns:mirror="clr-namespace:AchievementLabs.Mirror;assembly=AchievementLabs.MultiSelect"
        x:Class="AchievementLabs.Desktop.MainWindow" x:CompileBindings="True" x:DataType="local:DesktopModel" Title="Achievement Labs 1.0.6" Width="1440" Height="920" MinWidth="1120" MinHeight="720" Background="#000000" FontFamily="avares://Avalonia.Fonts.Inter/Assets#Inter" WindowStartupLocation="CenterScreen">
 <Design.DataContext><local:DesktopModel/></Design.DataContext>
 <Grid x:Name="PreviewRoot" Background="#000000" ColumnDefinitions="240,*" RowDefinitions="*,38">
  <Border Grid.RowSpan="2" Background="#050606" BorderBrush="#24272A" BorderThickness="0,0,1,0">
   <Grid RowDefinitions="Auto,*,Auto" Margin="20,26,16,18">
    <StackPanel Spacing="12">
     <Image Source="/Assets/achievement-labs-logo.png" Width="46" Height="46" HorizontalAlignment="Left" Stretch="Uniform"/>
     <TextBlock Text="ACHIEVEMENT" FontWeight="Bold" FontSize="17" LetterSpacing="1.6"/>
     <TextBlock Text="LABS" Foreground="{DynamicResource Accent}" FontWeight="SemiBold" FontSize="11" LetterSpacing="3" Margin="0,-8,0,0"/>
    </StackPanel>
    <ScrollViewer Grid.Row="1" Margin="0,24,0,16"><StackPanel Spacing="5">
     <TextBlock Text="WORKSPACE" Classes="eyebrow" Margin="12,0,0,12"/>
     <Button Classes="nav" Classes.active="{Binding IsHome}" Click="ShowHome" Content="⌂     Home"/>
     <Button x:Name="MirrorNav" Classes="nav" Classes.active="{Binding IsMirror}" Click="ShowMirror" Content="⇄     Achievement Mirror"/>
      <Expander IsExpanded="True"><Expander.Header><StackPanel Orientation="Horizontal" Spacing="9"><Image Source="/Assets/xbox-logo.jpg" Width="18" Height="18" Stretch="UniformToFill"/><TextBlock Text="Xbox"/></StackPanel></Expander.Header><StackPanel Margin="10,4,0,6" Spacing="3"><Button x:Name="LibraryNav" Classes="nav" Classes.active="{Binding IsLibrary}" Click="ShowLibrary" Content="Library"/><Button Classes="nav" Classes.active="{Binding IsXbox360Profiles}" Click="ShowXbox360Profiles" Content="Xbox 360 profiles"/><Button Classes="nav" Classes.active="{Binding IsGfwl}" Click="ShowGfwl" Content="GFWL"/><Button x:Name="AchievementsNav" Classes="nav" Classes.active="{Binding IsAchievements}" Click="ShowAchievements" Content="Achievements"/><Button Classes="nav" Classes.active="{Binding IsSpoofer}" Content="Title spoofer" Click="ShowSpoofer"/><Button Classes="nav" Classes.active="{Binding IsStats}" Content="Stats editor" Click="ShowStats"/><Button Name="XboxAutoUnlockNav" Classes="nav" Classes.active="{Binding IsQueues}" Content="Auto Unlocker" Click="ShowQueues"/><Button Classes="nav" Classes.active="{Binding IsDiagnostics}" Click="ShowDiagnostics" Content="Event catalog"/><Button Classes="nav" Classes.active="{Binding IsTools}" Content="Tools" Click="ShowTools"/></StackPanel></Expander>
      <Expander><Expander.Header><StackPanel Orientation="Horizontal" Spacing="9"><Image Source="/Assets/steam-logo.webp" Width="18" Height="18"/><TextBlock Text="Steam"/></StackPanel></Expander.Header><StackPanel Margin="10,4,0,6" Spacing="3"><Button Classes="nav" Classes.active="{Binding IsSteamLibrary}" Content="Library" Click="ShowSteam"/><Button Classes="nav" Classes.active="{Binding IsSteamAchievements}" Content="Achievements" Click="ShowSteamAchievements"/><Button Name="SteamAutoUnlockNav" Classes="nav" Classes.active="{Binding IsSteamQueue}" Content="Auto Unlocker" Click="ShowSteamQueue"/></StackPanel></Expander>
      <Expander><Expander.Header><StackPanel Orientation="Horizontal" Spacing="9"><Border Background="#D5D8DC" CornerRadius="3" Width="18" Height="18"><Image Source="/Assets/epic-logo.png" Margin="2"/></Border><TextBlock Text="Epic Games"/></StackPanel></Expander.Header><StackPanel Margin="10,4,0,6"><Button Classes="nav" Classes.active="{Binding IsEpic}" Content="Library and achievements" Click="ShowEpic"/></StackPanel></Expander>
      <Expander><Expander.Header><StackPanel Orientation="Horizontal" Spacing="9"><Border Background="#D5D8DC" CornerRadius="9" Width="18" Height="18"><Image Source="/Assets/ubisoft-logo.png" Margin="2"/></Border><TextBlock Text="Ubisoft Connect"/></StackPanel></Expander.Header><StackPanel Margin="10,4,0,6"><Button Classes="nav" Classes.active="{Binding IsUbisoft}" Content="Library, data and injector" Click="ShowUbisoft"/></StackPanel></Expander>
     <Button Classes="nav" Classes.active="{Binding IsSettings}" Click="ShowSettings" Content="⚙     Settings"/>
      <Button Classes="nav" Classes.active="{Binding IsAbout}" Click="ShowAbout" Content="ⓘ     About"/>
<Border Height="1" Background="#24272A" Margin="10,22"/>


    </StackPanel>
    </ScrollViewer><StackPanel Grid.Row="2" Spacing="14">
      <Border Background="#21352E" CornerRadius="10" Padding="12,8" IsVisible="{Binding Mirror.HasGlobalSummary}"><TextBlock Text="{Binding Mirror.GlobalSummary}" Foreground="#91CFB1" FontSize="11" TextWrapping="Wrap"/></Border>
      <Border Classes="panel" Padding="12"><StackPanel Spacing="6"><TextBlock Text="A space to experiment." FontSize="12"/><TextBlock Text="Achievement Labs 1.0.6" Classes="muted" FontSize="11"/></StackPanel></Border>
     <Grid ColumnDefinitions="34,*"><Grid Width="34" Height="34"><Border Background="#303642" CornerRadius="17"><TextBlock Text="U" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="11"/></Border><Border CornerRadius="17" ClipToBounds="True"><local:RemoteImage Url="{Binding ProfileImageUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Margin="10,0,0,0"><TextBlock Text="{Binding ProfileName}" FontSize="12"/><TextBlock Text="{Binding ConnectionLabel}" Classes="muted" FontSize="10"/></StackPanel></Grid>
    </StackPanel>
   </Grid>
  </Border>
  <Grid Grid.Column="1" RowDefinitions="Auto,*" Margin="30,24,30,20">
    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,22">
     <Button Content="←" Click="GoBack" IsEnabled="{Binding CanGoBack}" Margin="0,0,12,0"/>
     <TextBlock Grid.Column="1" Text="{Binding PageTitle}" FontSize="29" FontWeight="SemiBold" LetterSpacing="-0.8" VerticalAlignment="Center"/>
     <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
     <Button Content="Install update and restart" Click="InstallUpdate" IsVisible="{Binding UpdateReady}"/><Button Content="Attach Xbox PC app" Click="ConnectXbox" IsEnabled="{Binding CanConnect}"/><Button Click="ShowMobileSync" IsEnabled="{Binding CanQuery}" ToolTip.Tip="Sync with iPhone / iPad / Android" AutomationProperties.Name="Sync with iPhone / iPad / Android"><PathIcon Width="18" Height="18" Data="M 6,1 L 18,1 L 18,23 L 6,23 Z M 8,3 L 8,19 L 16,19 L 16,3 Z M 11,20 L 11,22 L 13,22 L 13,20 Z"/></Button><Button Content="Open export" Click="OpenExport" IsEnabled="{Binding CanInteract}"/>
     <Border Background="#21352E" CornerRadius="15" Padding="12,7" VerticalAlignment="Center"><TextBlock Text="{Binding ConnectionLabel}" Foreground="#91CFB1" FontSize="11"/></Border>
    </StackPanel>
   </Grid>
   <ScrollViewer Grid.Row="1" IsVisible="{Binding IsHome}">
    <StackPanel Spacing="20" MaxWidth="980">
     <Border Classes="panel" Padding="24"><Grid ColumnDefinitions="72,*"><Grid Width="64" Height="64"><Border Background="#151A17" CornerRadius="32"/><Border CornerRadius="32" ClipToBounds="True"><local:RemoteImage Url="{Binding ProfileImageUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center" Spacing="6"><TextBlock Text="{Binding ProfileName}" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Connected accounts and local game services" Classes="muted"/></StackPanel></Grid></Border>
     <UniformGrid Columns="2" Rows="2">
      <Border Classes="panel" Padding="22" Margin="0,0,10,10"><Grid ColumnDefinitions="62,*"><Grid Width="52" Height="52"><Border Background="#151A17" CornerRadius="26"/><Border CornerRadius="26" ClipToBounds="True"><local:RemoteImage Url="{Binding ProfileImageUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Spacing="9"><TextBlock Text="XBOX" Classes="eyebrow"/><TextBlock Text="{Binding HomeXboxSummary}" FontSize="16" TextWrapping="Wrap"/><TextBlock Text="{Binding XboxPcAttachmentLabel}" Foreground="#91CFB1" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding XboxPcAttachmentDetail}" Classes="muted" TextWrapping="Wrap"/><WrapPanel><Button Content="Retry attachment" Click="ConnectXbox" IsEnabled="{Binding CanConnect}"/><Button Content="Open Xbox app" Click="LaunchXboxAndAttach" IsEnabled="{Binding CanConnect}" Margin="8,0,0,0"/><Button Content="Library" Click="ShowLibrary" Margin="8,0,0,0"/></WrapPanel><TextBlock Text="{Binding EventTokenStatus}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Grid></Border>
      <Border Classes="panel" Padding="22" Margin="10,0,0,10"><Grid ColumnDefinitions="62,*"><Grid Width="52" Height="52"><Image Source="/Assets/steam-logo.webp"/><Border CornerRadius="26" ClipToBounds="True"><local:RemoteImage Url="{Binding SteamAvatarUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="STEAM" Classes="eyebrow"/><TextBlock Text="{Binding HomeSteamSummary}" FontSize="16" TextWrapping="Wrap"/><Button Content="Open Steam" Click="ShowSteam" HorizontalAlignment="Left"/></StackPanel></Grid></Border>
      <Border Classes="panel" Padding="22" Margin="0,10,10,0"><StackPanel Spacing="12"><TextBlock Text="EPIC GAMES" Classes="eyebrow"/><TextBlock Text="Local installation and captured achievement data" Classes="muted" TextWrapping="Wrap"/><Button Content="Open Epic Games" Click="ShowEpic" HorizontalAlignment="Left"/></StackPanel></Border>
      <Border Classes="panel" Padding="22" Margin="10,10,0,0"><StackPanel Spacing="12"><TextBlock Text="UBISOFT CONNECT" Classes="eyebrow"/><TextBlock Text="Local installation and captured game data" Classes="muted" TextWrapping="Wrap"/><Button Content="Open Ubisoft" Click="ShowUbisoft" HorizontalAlignment="Left"/></StackPanel></Border>
     </UniformGrid>
    </StackPanel>
   </ScrollViewer>
   <Grid Grid.Row="1" IsVisible="{Binding IsAchievements}" RowDefinitions="190,Auto,*">
    <Border CornerRadius="12" ClipToBounds="True" BorderBrush="#414245" BorderThickness="1">
     <Grid ColumnDefinitions="*,310">
      <Grid.Background><LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%"><GradientStop Color="#343A43" Offset="0"/><GradientStop Color="#192029" Offset="0.7"/><GradientStop Color="#102017" Offset="1"/></LinearGradientBrush></Grid.Background>
      <StackPanel Margin="28,24" Spacing="11">
       <TextBlock Text="{Binding SelectedGame.PlatformLabel}" Classes="eyebrow"/>
       <SelectableTextBlock Text="{Binding SelectedGame.Name}" FontSize="26" FontWeight="SemiBold" LetterSpacing="-0.7" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding SelectedGame.Description}" Foreground="#B7BDC6" MaxWidth="650" HorizontalAlignment="Left" TextWrapping="Wrap" FontSize="12"/>
       <StackPanel Orientation="Horizontal" Spacing="20" Margin="0,5,0,0"><TextBlock Text="{Binding SelectedGame.ProgressLabel}" FontWeight="SemiBold"/><Path Name="AchievementPageMythicIcon" IsVisible="{Binding SelectedGame.MythicVisible}" ToolTip.Tip="{Binding SelectedGame.CompletionTooltip}" Width="22" Height="22" Stretch="Uniform" Fill="{Binding SelectedGame.MythicColour}" Data="M50,12 L59,34 L83,36 L65,52 L71,77 L50,63 L29,77 L35,52 L17,36 L41,34 Z M20,70 Q5,49 16,25 Q2,31 3,45 Q4,57 14,65 Z M17,77 Q8,62 1,62 Q0,78 19,85 Z M27,87 Q16,77 9,81 Q14,95 34,96 Z M80,70 Q95,49 84,25 Q98,31 97,45 Q96,57 86,65 Z M83,77 Q92,62 99,62 Q100,78 81,85 Z M73,87 Q84,77 91,81 Q86,95 66,96 Z"/><TextBlock Text="{Binding SelectedGame.ScoreLabel}" Foreground="{DynamicResource Accent}"/></StackPanel>
       <TextBlock Text="{Binding GamePlaytimeText}" Foreground="{DynamicResource Accent}" FontSize="12"/>
      </StackPanel>
      <Grid Grid.Column="1" ClipToBounds="True">
       <Ellipse Width="224" Height="224" Stroke="#356A44" StrokeThickness="1" Opacity="0.35" Margin="80,-20,-30,-40"/>
       <Ellipse Width="156" Height="156" Stroke="#63B77B" StrokeThickness="1" Opacity="0.3" Margin="80,0,-30,0"/>
       <Path Data="M 20,140 L 85,44 L 119,91 L 153,18 L 236,140 Z" Stroke="{DynamicResource Accent}" StrokeThickness="2" Opacity="0.55" Stretch="Uniform" Width="175" Height="100" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <TextBlock Text="{Binding SelectedGame.Monogram}" FontSize="64" FontWeight="Bold" Opacity="0.18" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <local:RemoteImage Url="{Binding SelectedGame.ImageUrl}" Stretch="UniformToFill" Opacity="0.82"/>
      </Grid>
     </Grid>
    </Border>
    <StackPanel Grid.Row="1" Spacing="10" Margin="0,18,0,14">
     <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding TitleLookup, Mode=TwoWay}" PlaceholderText="Open Xbox achievements by title ID…" Tag="open-title" KeyDown="SubmitTextField"/><Button Grid.Column="1" Content="Open title" Click="LookupTitle" IsEnabled="{Binding CanQuery}" Margin="10,0,0,0"/></Grid>
     <Grid Name="AchievementToolbar" RowDefinitions="Auto,Auto" ColumnDefinitions="*,Auto,Auto,Auto"><StackPanel Orientation="Horizontal" Spacing="8"><Button x:Name="AllFilter" Content="All achievements" Click="FilterAll"/><Button Content="Locked" Click="FilterLocked" Background="Transparent"/><Button Content="Unlocked" Click="FilterUnlocked" Background="Transparent"/></StackPanel><StackPanel Grid.Column="1" Name="AchievementSortToolbar" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><TextBlock Text="Sort achievements" VerticalAlignment="Center" Classes="muted"/></StackPanel><Button Grid.Column="2" x:Name="OpenGameAutoSpoofer" Content="Open Auto Unlock" Margin="10,0"/><Button Grid.Column="3" x:Name="OpenGameTitleSpoofer" Content="Open Title Spoof" Click="OpenGameTitleSpoof" Margin="0,0,10,0"/>
     <TextBox Grid.Row="1" Grid.ColumnSpan="4" Margin="0,8,0,0" PlaceholderText="Search achievements…" Text="{Binding Search, Mode=TwoWay}"/></Grid>
    </StackPanel>
    <Grid Grid.Row="2" ColumnDefinitions="*,252">
     <Border Classes="panel" Margin="0,0,16,0">
      <Grid RowDefinitions="42,*,32">
       <Grid ColumnDefinitions="*,100,100,54" Margin="20,0" VerticalAlignment="Center"><TextBlock Text="ACHIEVEMENT" Classes="muted" FontSize="10" LetterSpacing="1"/><TextBlock Grid.Column="1" Text="GLOBAL %" ToolTip.Tip="Percentage of Xbox players of this title who unlocked this achievement" Classes="muted" FontSize="10"/><TextBlock Grid.Column="2" Text="STATUS" Classes="muted" FontSize="10"/><TextBlock Grid.Column="3" Text="SCORE" Classes="muted" FontSize="10"/></Grid>
       <ListBox Name="AchievementLabsAchievementList" Grid.Row="1" ItemsSource="{Binding VisibleAchievements}" SelectedItem="{Binding SelectedAchievement, Mode=TwoWay}" Background="Transparent" BorderThickness="0" Margin="6,0">
        <ListBox.ItemTemplate><DataTemplate x:DataType="local:Achievement">
         <Grid ColumnDefinitions="44,*,100,96,46" Margin="12,9">
          <Border Background="{Binding BadgeBackground}" Width="34" Height="34" CornerRadius="8" ClipToBounds="True"><Grid><TextBlock Text="{Binding Symbol}" Foreground="{Binding BadgeForeground}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/><local:RemoteImage Name="AchievementRowImage" Url="{Binding ImageUrl}" Stretch="UniformToFill"/></Grid></Border>
           <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="Medium" FontSize="12"/><TextBlock Text="{Binding Description}" Classes="muted" FontSize="10" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Spacing="3"><TextBlock Text="ID" Classes="muted" FontSize="9"/><TextBlock Text="{Binding Id}" Classes="muted" FontSize="9"/></StackPanel></StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding GlobalUnlockLabel}" ToolTip.Tip="Percentage of Xbox players of this title who unlocked this achievement" Classes="muted" FontSize="11" VerticalAlignment="Center"/><TextBlock Grid.Column="3" Text="{Binding Status}" Foreground="{Binding BadgeForeground}" FontSize="10" VerticalAlignment="Center"/>
          <TextBlock Grid.Column="4" Text="{Binding CompactScoreLabel}" FontSize="11" VerticalAlignment="Center" HorizontalAlignment="Right"/>
         </Grid>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
       <TextBlock Grid.Row="2" Text="{Binding ResultLabel}" Classes="muted" FontSize="10" Margin="20,6"/>
       <TextBlock Grid.Row="1" Text="No achievements match your filters." IsVisible="{Binding NoResults}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Grid>
     </Border>
     <Border Grid.Column="1" Classes="panel" Padding="20">
      <ScrollViewer><StackPanel Spacing="15">
       <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Refresh" Click="RefreshAchievements" IsEnabled="{Binding CanQuery}"/><Button Content="Export CSV" Click="ExportCsv" IsEnabled="{Binding CanExport}"/></StackPanel><TextBlock Text="ACHIEVEMENT DETAILS" Classes="eyebrow" FontSize="9"/>
       <Grid Width="56" Height="56" HorizontalAlignment="Left"><Border Background="#142018" CornerRadius="14"><TextBlock Text="◇" Foreground="{DynamicResource Accent}" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><Border CornerRadius="14" ClipToBounds="True"><local:RemoteImage Url="{Binding SelectedAchievement.ImageUrl}" Stretch="UniformToFill"/></Border></Grid>
       <TextBlock Text="{Binding SelectedAchievement.Name}" FontSize="19" FontWeight="SemiBold" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding SelectedAchievement.Description}" Classes="muted" FontSize="12" TextWrapping="Wrap" LineHeight="20"/>
       <Border Height="1" Background="{DynamicResource Line}"/>
       <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Gamerscore" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding SelectedAchievement.ScoreLabel}" FontSize="12"/></Grid>
       <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Achievement ID" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding SelectedAchievement.Id}" FontSize="12"/></Grid>
       <Grid ColumnDefinitions="*,Auto"><TextBlock Text="Status" Classes="muted" FontSize="11"/><TextBlock Grid.Column="1" Text="{Binding SelectedAchievement.Status}" FontSize="12"/></Grid>

        <Border IsVisible="{Binding TitleTesting}" Background="#142018" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel Spacing="4"><TextBlock Text="Testing" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="This title is actively being tested. Achievement IDs may not match, and some unlock requests may not work. Please verify each result before continuing." TextWrapping="Wrap" Classes="muted"/></StackPanel></Border>
        <Border IsVisible="{Binding TitleComingSoon}" Background="#142018" BorderBrush="{DynamicResource Accent}" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel Spacing="4"><TextBlock Text="Coming Soon" FontWeight="SemiBold" Foreground="{DynamicResource Accent}"/><TextBlock Text="This title does not yet have a usable testing template." TextWrapping="Wrap" Classes="muted"/></StackPanel></Border>
       <Border IsVisible="{Binding TitleNotSupported}" Background="#211616" BorderBrush="#B56B6B" BorderThickness="1" CornerRadius="8" Padding="12"><StackPanel Spacing="4"><TextBlock Text="Not Supported" FontWeight="SemiBold" Foreground="#D88A8A"/><TextBlock Text="This event-based title does not currently have a supported event template." TextWrapping="Wrap" Classes="muted"/></StackPanel></Border>
       <Button Content="Unlock / retry" Click="UnlockSelected" IsEnabled="{Binding CanUnlockSelected}" Classes="primary"/>
<Button Content="Unlock all locked" Click="UnlockAll" IsEnabled="{Binding CanUnlockAll}"/>
<TextBlock Text="{Binding ActionSummary}" TextWrapping="Wrap" Classes="muted" FontSize="11"/>
<ItemsControl ItemsSource="{Binding ActionReports}"><ItemsControl.ItemTemplate><DataTemplate x:DataType="local:ActionReport"><StackPanel Spacing="4" Margin="0,4"><TextBlock Text="{Binding Achievement}" TextWrapping="Wrap" FontSize="11"/><TextBlock Text="{Binding Result}" TextWrapping="Wrap" Classes="muted" FontSize="10"/></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
<TextBlock Text="Refresh after a request to check account progress." Classes="muted" FontSize="10" TextWrapping="Wrap" LineHeight="17"/>
      </StackPanel></ScrollViewer>
     </Border>
    </Grid>
   </Grid>
   <Border Grid.Row="1" IsVisible="{Binding IsLibrary}" Classes="panel" Padding="18">
    <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
     <Grid ColumnDefinitions="*,Auto"><StackPanel><TextBlock Text="XBOX LIBRARY" Classes="eyebrow"/><TextBlock Text="{Binding GameCount, StringFormat={}{0} titles}" Classes="muted" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="Fill missing totals" Click="FillMissingTotals" IsEnabled="{Binding CanFillTotals}"/><Button Content="Stop scan" Click="StopTotalsScan" IsVisible="{Binding TotalsRunning}"/><Button Content="Refresh" Click="RefreshLibrary" IsEnabled="{Binding CanQuery}"/></StackPanel></Grid>
     <StackPanel Grid.Row="1" Spacing="6"><StackPanel IsVisible="{Binding HasLibraryRefreshStatus}" Spacing="5"><TextBlock Name="LibraryRefreshStatusText" Text="{Binding LibraryRefreshStatus}" TextWrapping="Wrap" Classes="muted"/><ProgressBar Name="LibraryRefreshProgressBar" Minimum="0" Maximum="100" Value="{Binding LibraryRefreshPercent}" IsIndeterminate="{Binding LibraryRefreshIndeterminate}" IsVisible="{Binding LibraryRefreshing}" Height="6"/></StackPanel><TextBlock Text="{Binding TotalsStatus}" TextWrapping="Wrap" Classes="muted"/><Grid ColumnDefinitions="*,190,150"><TextBox Text="{Binding LibrarySearch, Mode=TwoWay}" PlaceholderText="Search Xbox games or title ID…"/><ComboBox Grid.Column="1" ItemsSource="{Binding PlatformFilters}" SelectedItem="{Binding PlatformFilter, Mode=TwoWay}" Margin="10,0,0,0"/><ComboBox Grid.Column="2" ItemsSource="{Binding LibrarySortOptions}" SelectedItem="{Binding LibrarySort, Mode=TwoWay}" Margin="10,0,0,0"/></Grid></StackPanel>
     <ListBox Grid.Row="2" Name="XboxLibraryList" AutoScrollToSelectedItem="False" ItemsSource="{Binding VisibleGames}" SelectedItem="{Binding SelectedLibraryGame, Mode=TwoWay}" Background="Transparent" BorderThickness="0">
      <ListBox.ItemTemplate><DataTemplate x:DataType="local:Game"><Border Background="{Binding CompletionBackground}" CornerRadius="8"><Grid ColumnDefinitions="54,*,165,Auto,Auto" ColumnSpacing="12" Margin="10,8"><Grid Width="54" Height="54"><Border Background="#171A1C" CornerRadius="8"><TextBlock Text="{Binding Monogram}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/></Border><Border CornerRadius="8" ClipToBounds="True"><local:RemoteImage Url="{Binding ImageUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Spacing="6" Margin="10,0"><SelectableTextBlock Text="{Binding Name}" FontSize="15" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding PlatformLabel}" Classes="muted" FontSize="10"/></StackPanel><Grid Name="LibraryCompletionCell" Grid.Column="2" ColumnDefinitions="*,Auto" ColumnSpacing="7" VerticalAlignment="Center"><TextBlock Text="{Binding ProgressLabel}" Classes="muted" TextWrapping="Wrap" VerticalAlignment="Center"/><Path Grid.Column="1" VerticalAlignment="Center" Name="MythicCompletionIcon" IsVisible="{Binding MythicVisible}" ToolTip.Tip="{Binding CompletionTooltip}" Width="22" Height="22" Stretch="Uniform" Fill="{Binding MythicColour}" Data="M50,12 L59,34 L83,36 L65,52 L71,77 L50,63 L29,77 L35,52 L17,36 L41,34 Z M20,70 Q5,49 16,25 Q2,31 3,45 Q4,57 14,65 Z M17,77 Q8,62 1,62 Q0,78 19,85 Z M27,87 Q16,77 9,81 Q14,95 34,96 Z M80,70 Q95,49 84,25 Q98,31 97,45 Q96,57 86,65 Z M83,77 Q92,62 99,62 Q100,78 81,85 Z M73,87 Q84,77 91,81 Q86,95 66,96 Z"/></Grid><TextBlock Grid.Column="3" Text="{Binding Id}" VerticalAlignment="Center" Margin="0,0,4,0"/><StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="7" HorizontalAlignment="Right"><Button Content="Copy ID" Tag="{Binding}" Click="CopyTitleId" Padding="10,7"/><Button Content="Open achievements" Tag="{Binding}" Click="OpenSelectedXboxGame" Padding="10,7" Classes="primary"/><Button Content="Open stats" Tag="{Binding}" Click="OpenLibraryStats" Padding="10,7"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate>
     </ListBox>
    </Grid>
   </Border>
   <TabControl Grid.Row="1" IsVisible="{Binding IsTools}"><TabItem Header="Title search"><Grid RowDefinitions="Auto,Auto,*"><Grid ColumnDefinitions="*,Auto,Auto" Margin="0,12"><TextBox Text="{Binding TitleSearch, Mode=TwoWay}" PlaceholderText="Search by game title" Tag="search-titles" KeyDown="SubmitTextField"/><Button Grid.Column="1" Content="Search titles" Click="SearchTitles" IsEnabled="{Binding CanInteract}" Margin="10,0,0,0"/><CheckBox Grid.Column="2" Content="Only verified achievements" IsChecked="{Binding OnlyVerifiedAchievementTitles, Mode=TwoWay}" VerticalAlignment="Center" Margin="14,0,0,0"/></Grid><TextBlock Grid.Row="1" Text="{Binding LookupOutput}" Classes="muted" Margin="0,0,0,8"/><ListBox Grid.Row="2" ItemsSource="{Binding TitleSearchResults}" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate x:DataType="local:TitleSearchResult"><Border Classes="panel" Padding="14" Margin="0,5"><Grid ColumnDefinitions="64,*,150,130" ColumnSpacing="14"><Grid Width="54" Height="54"><Border Background="#171A1C" CornerRadius="8"><TextBlock Text="{Binding Monogram}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/></Border><Border CornerRadius="8" ClipToBounds="True"><local:RemoteImage Url="{Binding ImageUrl}" Stretch="UniformToFill"/></Border></Grid><StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Center"><SelectableTextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Platform}" Classes="muted"/><TextBlock Text="{Binding AchievementCatalogStatus}" Classes="muted" FontSize="10"/></StackPanel><StackPanel Grid.Column="2" Spacing="5" VerticalAlignment="Center"><TextBlock Text="TITLE ID" Classes="eyebrow"/><TextBlock Text="{Binding TitleId}"/></StackPanel><StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center"><Button Content="Open achievements" Tag="{Binding}" Click="OpenSearchTitle"/><Button Content="Copy Title ID" Tag="{Binding}" Click="CopySearchTitleId"/><Button Content="Add GPD to profile" Tag="{Binding}" Click="AddTitleSearchGpd" IsVisible="{Binding CanAddXbox360Gpd}"/></StackPanel></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem><TabItem Header="Store link to Title ID"><StackPanel Margin="20" Spacing="14"><TextBlock Text="Store link to Xbox Title ID" FontSize="22"/><TextBlock Text="Paste a Store link or product code, such as 9WZDNCRFJB66." Classes="muted" TextWrapping="Wrap"/><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding StoreProductInput, Mode=TwoWay}" PlaceholderText="Store URL or product ID" Tag="resolve-store-title" KeyDown="SubmitTextField"/><Button Grid.Column="1" Content="Look up Title ID" Click="ResolveStoreTitle" IsEnabled="{Binding CanInteract}" Margin="10,0,0,0"/></Grid><TextBlock Text="{Binding StoreLookupStatus}" TextWrapping="Wrap" Classes="muted"/><TextBlock Text="{Binding StoreTitleName}" FontSize="18"/><SelectableTextBlock Text="{Binding StoreTitleId}" FontSize="24"/><WrapPanel><Button Content="Copy Title ID" Click="CopyStoreTitleId" IsEnabled="{Binding HasStoreTitleId}"/><Button Content="Open achievements" Click="OpenStoreAchievements" IsEnabled="{Binding HasStoreTitleId}" Margin="10,0,0,0"/></WrapPanel></StackPanel></TabItem><TabItem Header="Profile lookup"><Grid RowDefinitions="Auto,*"><StackPanel Margin="0,12" Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding GamertagSearch, Mode=TwoWay}" PlaceholderText="Gamertag" Tag="search-profile" KeyDown="SubmitTextField"/><Button Grid.Column="1" Content="Look up profile" Click="SearchGamertag" IsEnabled="{Binding CanQuery}"/></Grid><WrapPanel><CheckBox Content="Exclude zero-score games" IsChecked="{Binding ExcludeZeroScore, Mode=TwoWay}"/><CheckBox Content="Exclude Xbox 360" IsChecked="{Binding Exclude360, Mode=TwoWay}" Margin="14,0"/><Button Content="Export games CSV" Click="ExportProfileGames" IsEnabled="{Binding CanQuery}"/></WrapPanel></StackPanel><TextBox Grid.Row="1" Text="{Binding LookupOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/></Grid></TabItem><TabItem Header="Account"><StackPanel Spacing="14" Margin="20"><WrapPanel><Button Content="Refresh Xbox profile" Click="RefreshAccountProfile" IsEnabled="{Binding CanQuery}"/><Button Content="Show Steam profile" Click="ShowSteamProfile"/></WrapPanel><TextBox Text="{Binding AccountSummary}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/></StackPanel></TabItem><TabItem Header="Tools"><StackPanel Margin="20" Spacing="16"><TextBlock Text="{Binding ConverterStatus}" Classes="muted" TextWrapping="Wrap"/><WrapPanel><Button Content="Refresh converter status" Click="RefreshConverter"/><Button Content="Open Steam save-converter workspace" Tag="Steam converter" Click="OpenUtilityLink"/></WrapPanel><Button Content="Discord" Tag="Discord" Click="OpenUtilityLink"/></StackPanel></TabItem></TabControl>
   <TabControl Grid.Row="1" IsVisible="{Binding IsQueues}">
    <TabItem Header="Xbox"><Grid RowDefinitions="Auto,*,Auto" Margin="0,12">
     <StackPanel Spacing="12"><Expander Header="Saved game queues"><Border Classes="panel" Padding="10"><StackPanel Spacing="7">
      <TextBlock Text="Saved game queues" Classes="eyebrow"/>
      <ComboBox ItemsSource="{Binding XboxQueue.SavedGameQueues}" SelectedItem="{Binding XboxQueue.SelectedSavedGameQueue, Mode=TwoWay}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate x:DataType="workflows:AutoUnlockerViewModel+SavedGameQueueInfo"><TextBlock Text="{Binding Summary}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <WrapPanel IsEnabled="{Binding XboxQueue.IsConfigEnabled}"><Button Content="Save this game" Command="{Binding XboxQueue.SaveCurrentGameQueueCommand}" Margin="0,0,8,0"/><Button Content="Load separately" Command="{Binding XboxQueue.LoadSelectedGameQueueCommand}" Margin="0,0,8,0"/><Button Content="Add to end of build queue" Command="{Binding XboxQueue.AppendSelectedGameQueueCommand}"/><Button Content="Delete saved queue" Click="DeleteSavedGameQueue" Margin="8,0,0,0"/></WrapPanel>
      <WrapPanel IsEnabled="{Binding XboxQueue.IsConfigEnabled}"><Button Content="Export queue sync file" Click="ExportQueueSync" Margin="0,0,8,0"/><Button Content="Import queue sync file" Click="ImportQueueSync" Margin="0,0,8,0"/><Button Content="Export queue QR" Click="ExportQueueQr" Margin="0,0,8,0"/><Button Content="Import queue QR images" Click="ImportQueueQr"/></WrapPanel><TextBlock Text="Queues save automatically per game and account. Deleting a saved game also removes its loaded queue. Auto Unlock options are remembered automatically." Classes="muted" TextWrapping="Wrap"/>
     </StackPanel></Border></Expander><Grid ColumnDefinitions="*,*" IsEnabled="{Binding XboxQueue.IsConfigEnabled}"><TextBox Text="{Binding XboxQueue.ReferenceGamertag, Mode=TwoWay}" PlaceholderText="Reference gamertag" Tag="build-xbox-queue" KeyDown="SubmitTextField"/><TextBox Grid.Column="1" Text="{Binding XboxQueue.TitleId, Mode=TwoWay}" PlaceholderText="Title ID" Margin="10,0,0,0" Tag="build-xbox-queue" KeyDown="SubmitTextField"/></Grid><WrapPanel IsEnabled="{Binding CanQuery}"><Button Margin="0,0,8,6" Content="Build queue" Command="{Binding XboxQueue.BuildQueueCommand}"/><Button Margin="0,0,8,6" Content="Load saved queue" Command="{Binding XboxQueue.ResumeExistingSessionCommand}"/><Button Margin="0,0,8,6" Content="Clear saved queue" Command="{Binding XboxQueue.ClearExistingSessionCommand}"/><Button Margin="0,0,8,6" Content="Save queue delays" Command="{Binding XboxQueue.SaveQueueCommand}" IsEnabled="{Binding XboxQueue.IsConfigEnabled}"/></WrapPanel><WrapPanel Name="QueueUnlockOptions">

       <CheckBox Content="Notify on unlock failure" IsEnabled="{Binding XboxQueue.IsConfigEnabled}" IsChecked="{Binding XboxQueue.NotifyOnFailure, Mode=TwoWay}" Margin="0,0,16,0"/>
       <CheckBox Content="Stop on unlock failure" IsEnabled="{Binding XboxQueue.IsConfigEnabled}" IsChecked="{Binding XboxQueue.StopOnFailure, Mode=TwoWay}" Margin="0,0,16,0"/>
       <CheckBox Name="StopQueueOnSpoofFailure" Content="Stop auto unlock if spoofing fails" IsChecked="{Binding StopAutoUnlockOnSpoofFailure, Mode=TwoWay}" Margin="0,0,16,0"/>
       <CheckBox Name="NotifyQueueCompletion" Content="Notify when auto unlock completes" IsChecked="{Binding NotifyAutoUnlockCompletion, Mode=TwoWay}"/>
      </WrapPanel><TextBlock Text="Reference gaps receive up to ±1 minute of variation below one hour and up to ±5 minutes at one hour or longer. Simultaneous unlocks stay simultaneous. Edit any delay below before starting." TextWrapping="Wrap" Classes="muted"/><Grid ColumnDefinitions="*,*" ColumnSpacing="10">
       <Border Name="QueueStatusTile" Classes="panel" Padding="10">
        <StackPanel Spacing="4">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Text="QUEUE STATUS" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="{Binding XboxQueue.ProgressText}" Classes="muted"/></Grid>
         <TextBlock Text="{Binding XboxQueue.StatusText}" TextWrapping="Wrap"/>
         <TextBlock Text="{Binding XboxQueue.NextUnlockText}" TextWrapping="Wrap"/>
         <Grid ColumnDefinitions="*,*" ColumnSpacing="10"><TextBlock Text="{Binding XboxQueue.TimeRemainingText}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding XboxQueue.CompletionRemainingText}" TextWrapping="Wrap"/></Grid>
         <TextBlock Text="{Binding XboxQueue.EstimatedCompletionText}" TextWrapping="Wrap" Classes="muted"/>
        </StackPanel>
       </Border>
       <Border Name="QueueSpooferTile" Grid.Column="1" Classes="panel" Padding="10">
        <StackPanel Spacing="4">
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Text="TITLE SPOOFER" Classes="eyebrow"/><TextBlock x:Name="QueueSpooferSessionTimer" Grid.Column="1" Text="{Binding PresenceTimer}" FontSize="16" FontWeight="SemiBold"/></Grid>
         <SelectableTextBlock Text="{Binding ActiveSpoofTitle}" TextWrapping="Wrap"/>
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBlock Text="{Binding SpoofingStatus}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding PresenceElapsed}" Classes="muted"/></Grid>
         <TextBlock Text="{Binding PresenceHeartbeat}" TextWrapping="Wrap" Classes="muted"/>
         <TextBlock x:Name="QueueRecordedPlaytime" Text="Xbox-recorded playtime: —" TextWrapping="Wrap"/>
         <WrapPanel><Button Content="Open title spoofer" Click="ShowSpoofer" Margin="0,0,8,0" Padding="10,4"/><Button Content="Stop spoofing" Click="StopPresence" IsEnabled="{Binding PresenceRunning}" Padding="10,4"/></WrapPanel>
        </StackPanel>
       </Border>
      </Grid></StackPanel>
     <ListBox Grid.Row="1" Name="XboxAutoUnlockList" ItemsSource="{Binding XboxQueue.QueueItems}" Margin="0,15"><ListBox.ItemTemplate><DataTemplate x:DataType="workflows:AutoUnlockerViewModel+AutoUnlockQueueDisplay"><Border Background="{Binding RowBackground}" CornerRadius="6" Padding="4"><Grid ColumnDefinitions="*,220,150" Margin="10"><TextBlock Text="{Binding AchievementName}" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><NumericUpDown Value="{Binding DelayMinutes, Mode=TwoWay}" Minimum="0" Maximum="10080" Increment="0.5" Width="165" HorizontalContentAlignment="Left" IsEnabled="{Binding CanEditDelay}"/><TextBlock Text="min" VerticalAlignment="Center" Classes="muted"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Status}" VerticalAlignment="Center"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10"><Button Content="{Binding XboxQueue.StartStopButtonText}" Click="RunXboxQueue"/><Button Name="StopQueueSpoofing" Content="Stop spoofing" Click="StopPresence" IsEnabled="{Binding PresenceRunning}"/><TextBlock Text="Speed multiplier" VerticalAlignment="Center"/><NumericUpDown Value="{Binding XboxQueue.SpeedMultiplier, Mode=TwoWay}" IsEnabled="{Binding XboxQueue.IsConfigEnabled}" Minimum="0.1" Maximum="100" Increment="0.1" Width="130"/></StackPanel>
    </Grid></TabItem>
    <TabItem x:Name="BuildQueueTab" Header="Build Queue">
     <Grid RowDefinitions="Auto,*,Auto" Margin="0,12">
      <StackPanel Spacing="10">
       <Grid ColumnDefinitions="*,*,150"><TextBox Text="{Binding XboxBuildQueue.ReferenceGamertag, Mode=TwoWay}" PlaceholderText="Reference gamertag" Tag="add-build-game" KeyDown="SubmitTextField"/><TextBox Grid.Column="1" Text="{Binding XboxBuildQueue.TitleId, Mode=TwoWay}" PlaceholderText="Title ID" Tag="add-build-game" KeyDown="SubmitTextField" Margin="10,0"/><StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="Speed multiplier" Classes="muted"/><NumericUpDown Value="{Binding XboxBuildQueue.SpeedMultiplier, Mode=TwoWay}" Minimum="0.1" Maximum="100" Increment="0.1"/></StackPanel></Grid>
       <WrapPanel><Button Content="Add game" Command="{Binding XboxBuildQueue.AddGameCommand}" IsEnabled="{Binding XboxBuildQueue.CanAdd}"/><Button Content="Resume / retry selected" Command="{Binding XboxBuildQueue.ResumeSelectedCommand}"/><Button Content="Remove selected" Command="{Binding XboxBuildQueue.RemoveSelectedCommand}"/></WrapPanel>
       <TextBlock Text="{Binding XboxBuildQueue.Status}" TextWrapping="Wrap"/>
       <TextBlock Text="{Binding XboxBuildQueue.ActiveGame.StatusText}" TextWrapping="Wrap" Classes="muted"/>
       <TextBlock Text="{Binding XboxBuildQueue.ActiveGame.ProgressText}"/>
       <TextBlock Text="{Binding XboxBuildQueue.ActiveGame.TimeRemainingText}"/>
      </StackPanel>
      <ListBox Grid.Row="1" ItemsSource="{Binding XboxBuildQueue.Items}" SelectedItem="{Binding XboxBuildQueue.SelectedItem, Mode=TwoWay}" Margin="0,12"><ListBox.ItemTemplate><DataTemplate x:DataType="core:BuildQueueItem"><Grid ColumnDefinitions="*,140,180" Margin="10"><TextBlock Text="{Binding TitleName}" TextWrapping="Wrap"/><TextBlock Grid.Column="1" Text="{Binding TitleId}"/><TextBlock Grid.Column="2" Text="{Binding Status}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10"><Button Content="{Binding XboxBuildQueue.StartStopLabel}" Click="RunXboxBuildQueue"/><TextBlock Text="Between titles (seconds)" VerticalAlignment="Center"/><NumericUpDown Value="{Binding BuildQueueBufferSeconds, Mode=TwoWay}" Minimum="0" Maximum="3600" Increment="5" Width="130" IsEnabled="{Binding XboxBuildQueue.CanConfigureBuffer}"/></StackPanel>
     </Grid>
    </TabItem>

   </TabControl>
     <Grid Grid.Row="1" IsVisible="{Binding IsSteamQueue}" RowDefinitions="Auto,*,Auto" Margin="0,12"><StackPanel Spacing="12"><Grid ColumnDefinitions="*,*"><TextBox Text="{Binding SteamQueue.AppId, Mode=TwoWay}" PlaceholderText="Steam app ID"/><TextBox Grid.Column="1" Text="{Binding SteamQueue.TargetProfile, Mode=TwoWay}" PlaceholderText="Reference Steam profile" Margin="10,0,0,0"/></Grid><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Load locked achievements" Command="{Binding SteamQueue.LoadQueueCommand}"/><Button Content="Load profile queue" Command="{Binding SteamQueue.LoadProfileQueueCommand}"/><Button Content="Clear" Command="{Binding SteamQueue.ClearQueueCommand}"/></StackPanel><WrapPanel><TextBlock Text="Min delay (seconds)" VerticalAlignment="Center" Margin="0,0,8,0"/><NumericUpDown Value="{Binding SteamQueue.MinimumDelaySeconds, Mode=TwoWay}" Width="110"/><TextBlock Text="Max delay" VerticalAlignment="Center" Margin="12,0,8,0"/><NumericUpDown Value="{Binding SteamQueue.MaximumDelaySeconds, Mode=TwoWay}" Width="110"/><TextBlock Text="Profile time scale" VerticalAlignment="Center" Margin="12,0,8,0"/><NumericUpDown Value="{Binding SteamQueue.ProfileTimeScale, Mode=TwoWay}" Width="110"/></WrapPanel><Border Classes="panel" Padding="16"><StackPanel Spacing="8"><TextBlock Text="STEAM QUEUE STATUS" Classes="eyebrow"/><TextBlock Text="{Binding SteamQueue.ProgressText}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding SteamQueue.StatusText}" TextWrapping="Wrap"/><TextBlock Text="{Binding SteamQueue.TargetProfileStatus}" Classes="muted" TextWrapping="Wrap"/></StackPanel></Border></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding SteamQueue.QueueItems}" Margin="0,15"><ListBox.ItemTemplate><DataTemplate x:DataType="models:SteamAutoUnlockQueueItem"><Grid ColumnDefinitions="*,100,180" Margin="10"><TextBlock Text="{Binding Name}"/><TextBlock Grid.Column="1" Text="{Binding DelaySeconds}"/><TextBlock Grid.Column="2" Text="{Binding Status}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="10"><Button Content="Start queue" Click="RunSteamQueue" IsEnabled="{Binding CanInteract}"/><Button Content="Stop" Command="{Binding SteamQueue.StopCommand}"/></StackPanel></Grid>
     <ScrollViewer Grid.Row="1" IsVisible="{Binding IsMirror}" x:Name="MirrorPage">
      <StackPanel Spacing="14" Margin="0,4,12,24" DataContext="{Binding Mirror}" x:DataType="workflows:AchievementMirrorViewModel">
       <TextBlock Text="Pair a Steam game with an Xbox title. New unlocks on one platform appear on the other as they happen. Monitoring keeps running while you use other pages." Classes="muted" TextWrapping="Wrap"/>
       <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
        <ComboBox ItemsSource="{Binding Pairs}" SelectedItem="{Binding SelectedPair}" HorizontalAlignment="Stretch" IsEnabled="{Binding !IsScanning}">
         <ComboBox.ItemTemplate><DataTemplate x:DataType="mirror:MirrorPair"><TextBlock Text="{Binding DisplayName}"/></DataTemplate></ComboBox.ItemTemplate>
        </ComboBox>
        <Button Grid.Column="1" Content="New pair" Command="{Binding NewPairCommand}"/>
        <Button Grid.Column="2" Content="Delete pair" Command="{Binding DeletePairCommand}" IsEnabled="{Binding CanEditPair}"/>
       </Grid>
       <Border Classes="panel" Padding="16">
        <StackPanel Spacing="10">
         <TextBlock Text="PAIRING" Classes="eyebrow"/>
         <StackPanel Orientation="Horizontal" Spacing="16">
          <TextBlock Text="Direction" Classes="muted" VerticalAlignment="Center"/>
          <RadioButton GroupName="MirrorDirection" Content="Steam → Xbox" IsChecked="{Binding IsSteamToXbox}" IsEnabled="{Binding CanEditPair}"/>
          <RadioButton GroupName="MirrorDirection" Content="Xbox → Steam" IsChecked="{Binding IsXboxToSteam}" IsEnabled="{Binding CanEditPair}"/>
         </StackPanel>
         <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
          <TextBox Text="{Binding SteamAppIdText}" PlaceholderText="Steam App ID, e.g. 3669870" IsEnabled="{Binding CanEditPair}"/>
          <TextBox Grid.Column="1" Text="{Binding XboxTitleIdText}" PlaceholderText="Xbox Title ID, e.g. 1653280174" IsEnabled="{Binding CanEditPair}"/>
         </Grid>
         <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBox Text="{Binding StoreLinkText}" PlaceholderText="Or paste an Xbox Store link to look up the Title ID" IsEnabled="{Binding CanEditPair}"/>
          <Button Grid.Column="1" Content="Look up Title ID" Command="{Binding LookupStoreLinkCommand}" IsEnabled="{Binding CanEditPair}"/>
         </Grid>
         <TextBox Text="{Binding SteamIdText}" PlaceholderText="Your SteamID64 (filled in automatically when Steam is signed in on this PC)" IsEnabled="{Binding CanEditPair}"/>
         <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <TextBox Text="{Binding ApiKeyInput}" PasswordChar="•" PlaceholderText="Steam Web API key from steamcommunity.com/dev/apikey"/>
          <Button Grid.Column="1" Content="Save key" Command="{Binding SaveApiKeyCommand}"/>
          <Button Grid.Column="2" Content="Remove key" Command="{Binding ClearApiKeyCommand}" IsVisible="{Binding HasApiKey}"/>
         </Grid>
         <TextBlock Text="{Binding ApiKeyStatus}" Classes="muted" TextWrapping="Wrap"/>
         <Button Content="Scan and match" Classes="primary" Command="{Binding ScanCommand}" IsEnabled="{Binding CanEditPair}"/>
        </StackPanel>
       </Border>
       <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding Status}" TextWrapping="Wrap" VerticalAlignment="Center"/>
        <Border Grid.Column="1" Background="{Binding StateBackground}" CornerRadius="12" Padding="10,5" VerticalAlignment="Center"><TextBlock Text="{Binding StateLabel}" Foreground="{Binding StateForeground}" FontSize="11"/></Border>
       </Grid>
       <Border Background="#40331A" CornerRadius="8" Padding="12"><TextBlock Text="{Binding WarningText}" Foreground="#F0C674" TextWrapping="Wrap"/></Border>
       <Border Background="#4A2323" CornerRadius="8" Padding="12" IsVisible="{Binding IsStopped}">
        <StackPanel Spacing="8">
         <TextBlock Text="Mirroring stopped" FontWeight="SemiBold" Foreground="#F2A7A7"/>
         <TextBlock Text="{Binding StopReason}" TextWrapping="Wrap" Foreground="#F2A7A7"/>
         <TextBlock Text="{Binding PendingText}" TextWrapping="Wrap" Foreground="#F2A7A7"/>
         <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="Resume and send pending in order" Command="{Binding ResumeSendPendingCommand}"/>
          <Button Content="Resume and discard pending" Command="{Binding ResumeDiscardPendingCommand}"/>
         </StackPanel>
        </StackPanel>
       </Border>
       <Border Classes="panel">
        <StackPanel>
         <TextBlock Text="{Binding MatchSummary, StringFormat='Match · {0}'}" FontWeight="SemiBold" Margin="14,12"/>
         <Grid ColumnDefinitions="*,24,*,210" ColumnSpacing="6" Margin="14,0,14,6">
          <TextBlock Text="{Binding SourceHeader}" Classes="muted"/>
          <TextBlock Grid.Column="2" Text="{Binding TargetHeader}" Classes="muted"/>
          <TextBlock Grid.Column="3" Text="Status" Classes="muted"/>
         </Grid>
         <ItemsControl ItemsSource="{Binding Rows}" x:Name="MirrorRows">
          <ItemsControl.ItemTemplate>
           <DataTemplate x:DataType="workflows:MirrorRowViewModel">
            <Border BorderBrush="{DynamicResource Line}" BorderThickness="0,1,0,0" Padding="14,8">
             <Grid ColumnDefinitions="*,24,*,210" ColumnSpacing="6">
              <TextBlock Text="{Binding SourceName}" VerticalAlignment="Center" TextWrapping="Wrap"/>
              <TextBlock Grid.Column="1" Text="→" Classes="muted" VerticalAlignment="Center"/>
              <ComboBox Grid.Column="2" ItemsSource="{Binding Options}" SelectedItem="{Binding SelectedOption}" PlaceholderText="Choose an achievement" HorizontalAlignment="Stretch" IsEnabled="{Binding #MirrorRows.((workflows:AchievementMirrorViewModel)DataContext).CanEditPair}"/>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
               <Border Background="{Binding StatusBackground}" CornerRadius="10" Padding="8,3"><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusForeground}" FontSize="11"/></Border>
               <Button Content="Confirm" Padding="10,4" FontSize="11" Command="{Binding ConfirmCommand}" IsVisible="{Binding NeedsConfirm}"/>
              </StackPanel>
             </Grid>
            </Border>
           </DataTemplate>
          </ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Border>
       <StackPanel Orientation="Horizontal" Spacing="6">
        <CheckBox IsChecked="{Binding MirrorAppUnlocks}">
         <StackPanel><TextBlock Text="{Binding AppUnlocksLabel}"/><TextBlock Text="{Binding AppUnlocksDetail}" Classes="muted" FontSize="11"/></StackPanel>
        </CheckBox>
        <Button Classes="help" Content="?" IsVisible="{Binding IsSteamToXbox}" ToolTip.Tip="{x:Static workflows:AchievementMirrorViewModel.SteamHelpText}" AutomationProperties.Name="About this setting">
         <Button.Flyout><Flyout><TextBlock Text="{x:Static workflows:AchievementMirrorViewModel.SteamHelpText}" MaxWidth="380" TextWrapping="Wrap"/></Flyout></Button.Flyout>
        </Button>
        <Button Classes="help" Content="?" IsVisible="{Binding IsXboxToSteam}" ToolTip.Tip="{x:Static workflows:AchievementMirrorViewModel.XboxHelpText}" AutomationProperties.Name="About this setting">
         <Button.Flyout><Flyout><TextBlock Text="{x:Static workflows:AchievementMirrorViewModel.XboxHelpText}" MaxWidth="380" TextWrapping="Wrap"/></Flyout></Button.Flyout>
        </Button>
       </StackPanel>
       <StackPanel Orientation="Horizontal" Spacing="10">
        <Button Content="{Binding StartStopLabel}" Classes="primary" Command="{Binding StartStopCommand}"/>
        <Button Content="Rescan" Command="{Binding ScanCommand}" IsEnabled="{Binding CanEditPair}"/>
       </StackPanel>
       <Border Classes="panel" Padding="14">
        <StackPanel Spacing="4">
         <TextBlock Text="ACTIVITY" Classes="eyebrow"/>
         <ItemsControl ItemsSource="{Binding LogEntries}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="mirror:MirrorLogEntry"><TextBlock Text="{Binding Line}" FontFamily="Consolas,Menlo,monospace" FontSize="11" TextWrapping="Wrap" Classes="muted"/></DataTemplate></ItemsControl.ItemTemplate>
         </ItemsControl>
        </StackPanel>
       </Border>
      </StackPanel>
     </ScrollViewer>
     <Grid Grid.Row="1" IsVisible="{Binding IsXbox360Profiles}" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="14">
      <TextBlock Text="Extract a profile from USB with a verified backup, then load the local working copy. The Xbox library stays combined; Open uses this profile for Xbox 360 games." TextWrapping="Wrap" Classes="muted"/>
      <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><Button Content="1. Extract USB profile and backup" Click="ExtractUsbProfile" IsEnabled="{Binding CanInteract}"/><Button Content="Open profiles folder" Click="OpenProfilesFolder"/><Button Content="Refresh local profiles" Click="RefreshLocalXbox360Profiles"/></StackPanel>
      <Grid Grid.Row="2" ColumnDefinitions="*,Auto" ColumnSpacing="8"><ComboBox ItemsSource="{Binding LocalXbox360Profiles}" SelectedItem="{Binding SelectedLocalXbox360Profile, Mode=TwoWay}"/><Button Grid.Column="1" Content="2. Load selected profile" Click="LoadSelectedXbox360Profile" IsEnabled="{Binding CanInteract}"/></Grid>
      <Grid Grid.Row="3" ColumnDefinitions="*,*" ColumnSpacing="16"><StackPanel Spacing="8"><TextBlock Text="Loaded profile" Classes="eyebrow"/><TextBlock Text="{Binding LoadedXbox360Profile}" TextWrapping="Wrap"/><TextBlock Text="{Binding UsbProfileStatus}" Classes="muted" TextWrapping="Wrap"/><Button Content="3. Inject loaded profile to USB" Click="InjectXbox360Profile" IsEnabled="{Binding CanInjectXbox360Profile}" HorizontalAlignment="Left"/><TextBlock Text="Injection creates a verified backup of the USB profile before replacing it." Classes="muted" TextWrapping="Wrap"/><Border Height="1" Background="#24272A" Margin="0,14"/><TextBlock Text="ADD GAME FROM GPD" Classes="eyebrow"/><TextBlock Text="{Binding GpdDirectory}" Classes="muted" TextWrapping="Wrap"/><Button Content="Open GPD catalog folder" Click="OpenGpdFolder" HorizontalAlignment="Left"/><Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"><TextBox Text="{Binding GpdTitleId, Mode=TwoWay}" PlaceholderText="Xbox 360 title ID (hex or decimal)"/><Button Grid.Column="1" Content="Add GPD to loaded profile" Click="AddXbox360Gpd" IsEnabled="{Binding CanModifyXbox360Profile}"/></Grid><TextBlock Text="{Binding GpdAddStatus}" Classes="muted" TextWrapping="Wrap"/></StackPanel><Grid Grid.Column="1" RowDefinitions="Auto,*"><TextBlock Text="Games in loaded profile" Classes="eyebrow"/><ListBox Grid.Row="1" ItemsSource="{Binding Xbox360Games}" SelectedItem="{Binding SelectedXbox360Game, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="models:Xbox360ProfileGame"><StackPanel Margin="5"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding TitleId}" Classes="muted"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Grid>
      <TextBlock Grid.Row="4" Text="{Binding LegacyOutput}" TextWrapping="Wrap" Classes="muted"/>
     </Grid>
     <Grid Grid.Row="1" IsVisible="{Binding IsXbox360ProfileEditor}" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="12">
      <StackPanel Spacing="5"><TextBlock Text="{Binding Xbox360EditorTitleName}" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{Binding Xbox360EditorTitleId}" Classes="muted"/><TextBlock Text="{Binding LoadedXbox360Profile}" Classes="muted" TextWrapping="Wrap"/><Button Content="Manage Xbox 360 profile" Click="ShowXbox360Profiles" HorizontalAlignment="Left"/></StackPanel>
      <TextBlock Grid.Row="1" Text="Local Xbox 360 profile achievements" Classes="eyebrow"/>
      <Grid Grid.Row="2" ColumnDefinitions="*,*" ColumnSpacing="14">
       <ListBox ItemsSource="{Binding Xbox360Achievements}" SelectedItem="{Binding SelectedXbox360Achievement, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="models:Xbox360ProfileAchievement"><Grid ColumnDefinitions="*,130,80" Margin="8"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted"/><TextBlock Grid.Column="2" Text="{Binding Gamerscore}" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
       <StackPanel Grid.Column="1" Spacing="12"><TextBlock Text="{Binding SelectedXbox360Achievement.Name}" FontSize="20" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedXbox360Achievement.Status}"/><TextBlock Text="{Binding SelectedXbox360Achievement.Gamerscore}"/><TextBlock Text="{Binding SelectedXbox360Achievement.UnlockedDescription}" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedXbox360Achievement.LockedDescription}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding SelectedXbox360Achievement.UnlockedAt}" Classes="muted"/><TextBlock Text="Unlock state" Classes="eyebrow"/><ComboBox ItemsSource="{Binding Xbox360UnlockModes}" SelectedItem="{Binding Xbox360UnlockMode, Mode=TwoWay}"/><TextBlock Text="Unlock time (local, yyyy-MM-dd HH:mm:ss.fff)" Classes="eyebrow"/><TextBox Text="{Binding Xbox360UnlockTimeText, Mode=TwoWay}" IsEnabled="{Binding CanEditXbox360UnlockTime}"/><StackPanel Orientation="Horizontal" Spacing="12"><Button Content="Set" Click="SetXbox360Achievement" IsEnabled="{Binding CanModifyXbox360Profile}"/><Button Content="Save working copy" Click="SaveXbox360Edits" IsEnabled="{Binding CanSaveXbox360Edits}" Classes="primary"/><Button Content="Inject to USB" Click="InjectXbox360Profile" IsEnabled="{Binding CanInjectXbox360Profile}"/><TextBlock Text="{Binding PendingXbox360EditCount, StringFormat='{}{0} pending edits'}" VerticalAlignment="Center" Classes="muted"/></StackPanel><TextBlock Text="{Binding Xbox360SigningStatus}" TextWrapping="Wrap" Foreground="#E0B96C"/><TextBlock Text="Save signs and verifies the local profile with a pre-save backup. Inject creates and verifies a separate USB backup before replacing the profile." TextWrapping="Wrap" Classes="muted"/></StackPanel>
      </Grid>
      <TextBlock Grid.Row="3" Text="{Binding LegacyOutput}" TextWrapping="Wrap" Classes="muted"/>
     </Grid>
     <Grid Grid.Row="1" IsVisible="{Binding IsGfwl}" RowDefinitions="Auto,Auto,Auto,*,Auto" RowSpacing="12" Margin="8,0">
      <StackPanel Spacing="4"><TextBlock Text="Games for Windows LIVE achievement manager" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="{Binding SelectedGfwlTitle.Name}" FontSize="16"/><TextBlock Text="Run the 32-bit GFWL game and sign in inside it, then select its process." Classes="muted" TextWrapping="Wrap"/></StackPanel>
      <Grid Grid.Row="1" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10"><ComboBox ItemsSource="{Binding GfwlProcesses}" SelectedItem="{Binding SelectedGfwlProcess, Mode=TwoWay}" PlaceholderText="Select GFWL game process"><ComboBox.ItemTemplate><DataTemplate x:DataType="models:GfwlProcessItem"><StackPanel Orientation="Horizontal" Spacing="10"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding ProcessId}" Classes="muted"/><TextBlock Text="{Binding Status}" Classes="muted"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox><CheckBox Grid.Column="1" Content="Show all processes (compatibility mode)" IsChecked="{Binding ShowAllGfwlProcesses, Mode=TwoWay}" VerticalAlignment="Center"/><Button Grid.Column="2" Content="Select game process" Click="ScanGfwl" IsEnabled="{Binding CanInteract}"/></Grid>
      <Grid Grid.Row="2" ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="9"><Button Content="Connect to selected game" Click="InjectGfwl" IsEnabled="{Binding CanInteract}"/><Button Grid.Column="1" Content="Refresh achievements" Click="RefreshGfwlAchievements" IsEnabled="{Binding CanInteract}"/><Button Grid.Column="2" Content="Earn selected" Click="EarnGfwlAchievement" IsEnabled="{Binding CanEarnGfwlAchievement}"/><TextBox Grid.Column="3" Text="{Binding GfwlSearch, Mode=TwoWay}" PlaceholderText="Search achievement name or ID"/></Grid>
      <Grid Grid.Row="3" RowDefinitions="Auto,*"><Grid ColumnDefinitions="68,65,150,*,*" Margin="12,0"><TextBlock Text="ID" Classes="eyebrow"/><TextBlock Grid.Column="1" Text="G" Classes="eyebrow"/><TextBlock Grid.Column="2" Text="TIME / STATE" Classes="eyebrow"/><TextBlock Grid.Column="3" Text="NAME" Classes="eyebrow"/><TextBlock Grid.Column="4" Text="DESCRIPTION" Classes="eyebrow"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding VisibleGfwlAchievements}" SelectedItem="{Binding SelectedGfwlAchievement, Mode=TwoWay}" DoubleTapped="EarnGfwlFromDoubleTap"><ListBox.ItemTemplate><DataTemplate x:DataType="gfwl:GfwlAchievement"><Grid ColumnDefinitions="68,65,150,*,*" Margin="9,7"><TextBlock Text="{Binding Id}"/><TextBlock Grid.Column="1" Text="{Binding Gamerscore}"/><TextBlock Grid.Column="2" Text="{Binding TimeText}" TextWrapping="Wrap"/><TextBlock Grid.Column="3" Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Grid.Column="4" Text="{Binding Description}" Classes="muted" TextWrapping="Wrap"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
      <Border Grid.Row="4" Classes="panel" Padding="12"><TextBlock Text="{Binding GfwlStatus}" TextWrapping="Wrap"/></Border>
     </Grid>

    <ScrollViewer Grid.Row="1" IsVisible="{Binding IsAbout}"><StackPanel Spacing="18" MaxWidth="760" HorizontalAlignment="Left"><Image Source="/Assets/achievement-labs-logo.png" Width="86" Height="86" HorizontalAlignment="Left"/><TextBlock Text="Achievement Labs" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Achievement Labs is a unified desktop workspace for viewing and managing achievements across Xbox, Steam, and legacy PC ecosystems. It combines account-aware libraries, achievement tools, title research, and community-tested compatibility in a native Avalonia interface." TextWrapping="Wrap" LineHeight="22"/><TextBlock Text="Achievement Labs builds on the original Ultimate Xbox Achievement Unlocker (XAU) project. Credit and thanks go to ItsLogic and the original contributors whose work made this project possible." TextWrapping="Wrap" Classes="muted" LineHeight="21"/><WrapPanel><Button Content="Achievement Labs on GitHub" Tag="GitHub" Click="OpenUtilityLink"/><Button Content="Original XAU project" Tag="Original XAU" Click="OpenUtilityLink" Margin="8,0,0,0"/><Button Content="Join Discord" Tag="Discord" Click="OpenUtilityLink" Margin="8,0,0,0"/></WrapPanel></StackPanel></ScrollViewer>
   <Border Grid.Row="1" IsVisible="{Binding IsSteamLibrary}" Classes="panel" Padding="18">
    <Grid RowDefinitions="Auto,*" RowSpacing="12"><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding SteamSearch, Mode=TwoWay}" PlaceholderText="Search Steam games or app ID…"/><Button Grid.Column="1" Content="Refresh library" Click="ShowSteam" IsEnabled="{Binding CanInteract}" Margin="10,0,0,0"/></Grid><ListBox Grid.Row="1" ItemsSource="{Binding SteamGames}" SelectedItem="{Binding SelectedSteamGame, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="models:SteamGameItem"><Grid ColumnDefinitions="64,*,120,150" Margin="10,8"><Grid Width="54" Height="54"><Border Background="#171A1C" CornerRadius="8"/><local:RemoteImage Url="{Binding ImageUrl}" Stretch="UniformToFill"/></Grid><StackPanel Grid.Column="1" Spacing="6" Margin="10,0"><SelectableTextBlock Text="{Binding DisplayName}" FontSize="15"/><TextBlock Text="{Binding Status}" Classes="muted" FontSize="10"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding AppId}" VerticalAlignment="Center"/><Button Grid.Column="3" Content="Open achievements" Tag="{Binding}" Click="OpenSteamAchievements" Classes="primary"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid>
   </Border>
   <Grid Grid.Row="1" IsVisible="{Binding IsSteamAchievements}" RowDefinitions="Auto,Auto,*,Auto">
    <StackPanel Spacing="12"><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding SteamAppId, Mode=TwoWay}" PlaceholderText="Open Steam achievements by app ID…" Tag="load-steam" KeyDown="SubmitTextField"/><Button Grid.Column="1" Content="Load achievements" Click="LoadSteam" IsEnabled="{Binding CanInteract}" Margin="10,0,0,0"/></Grid><TextBlock Text="{Binding SteamStatus}" TextWrapping="Wrap"/><TextBox Text="{Binding SteamAchievementSearch, Mode=TwoWay}" PlaceholderText="Search achievements by name or ID…"/></StackPanel>
    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8" Margin="0,12"><Button Content="Select all" Click="SelectAllSteam" IsEnabled="{Binding CanInteract}"/><Button Content="Clear all" Click="ClearAllSteam" IsEnabled="{Binding CanInteract}"/><Button Content="Invert" Click="InvertSteam"/><Button Content="Revert" Click="RevertSteam"/><Button Content="Save changes" Click="SaveSteam" IsEnabled="{Binding CanInteract}" Classes="primary"/></StackPanel>
    <ListBox Grid.Row="2" ItemsSource="{Binding VisibleSteamAchievements}" IsEnabled="{Binding CanInteract}"><ListBox.ItemTemplate><DataTemplate x:DataType="models:SteamAchievementItem"><Grid ColumnDefinitions="40,*" Margin="8"><CheckBox IsChecked="{Binding DesiredUnlocked, Mode=TwoWay}"/><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Id}" Classes="muted" FontSize="11"/><TextBlock Text="{Binding Description}" TextWrapping="Wrap" Classes="muted"/></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
    <StackPanel Grid.Row="3" Orientation="Horizontal" Spacing="8" Margin="0,12,0,0"><Button Content="Start presence" Click="StartSteamPresence" IsEnabled="{Binding CanInteract}"/><Button Content="Stop presence" Click="StopSteamPresence"/><Button Content="Reset stats" Click="ResetSteamStats" IsEnabled="{Binding CanInteract}"/><Button Content="Refresh metadata" Click="RefreshSteamMetadata" IsEnabled="{Binding CanInteract}"/></StackPanel>
   </Grid>
   <Grid Grid.Row="1" IsVisible="{Binding IsPlatform}" RowDefinitions="Auto,*">
    <Border IsVisible="{Binding IsEpic}" Background="#17140A" BorderBrush="#A88622" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"><TextBlock Text="Epic Games features are still in development and are not finalized. Compatibility and behavior may change." Foreground="#E1CA7A" TextWrapping="Wrap"/></Border>
    <Border IsVisible="{Binding IsUbisoft}" Background="#17140A" BorderBrush="#A88622" BorderThickness="1" CornerRadius="8" Padding="14,10" Margin="0,0,0,14"><TextBlock Text="Ubisoft features are still in development and are not finalized. The data tools and injector may have limited compatibility and may change." Foreground="#E1CA7A" TextWrapping="Wrap"/></Border>
    <Grid Grid.Row="1" ColumnDefinitions="290,*">
     <Grid RowDefinitions="Auto,*,Auto" Margin="0,0,20,0"><TextBox Text="{Binding PlatformSearch, Mode=TwoWay}" PlaceholderText="Search installed titles…"/><ListBox Grid.Row="1" ItemsSource="{Binding PlatformTitles}" SelectedItem="{Binding SelectedPlatformTitle, Mode=TwoWay}" Margin="0,12"><ListBox.ItemTemplate><DataTemplate x:DataType="local:PlatformTitle"><StackPanel Spacing="6" Margin="6"><SelectableTextBlock Text="{Binding Name}" TextWrapping="Wrap"/><TextBlock Text="{Binding Id}" Classes="muted" FontSize="11"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8"><Button Content="Refresh" Click="RefreshPlatform" IsEnabled="{Binding CanInteract}"/><Button Content="Copy context" Click="CopyPlatformContext"/><Button Content="Folder" Click="OpenPlatformFolder"/></StackPanel></Grid>
     <TabControl Grid.Column="1"><TabItem Header="Title data"><Grid RowDefinitions="Auto,*"><ComboBox ItemsSource="{Binding PlatformSections}" SelectedItem="{Binding PlatformSection, Mode=TwoWay}" IsVisible="{Binding IsUbisoft}" Margin="0,10"/><ListBox Grid.Row="1" ItemsSource="{Binding PlatformDetails}" SelectedItem="{Binding SelectedPlatformDetail, Mode=TwoWay}"><ListBox.ItemTemplate><DataTemplate x:DataType="local:PlatformDetail"><StackPanel Spacing="6" Margin="10"><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/><TextBlock Text="{Binding Id}" Classes="muted"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap"/><TextBlock Text="{Binding State}" Classes="muted" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem>
     <TabItem Header="Configuration"><ScrollViewer><StackPanel Spacing="14" Margin="20">
      <StackPanel IsVisible="{Binding IsEpic}" Spacing="10"><TextBlock Text="Epic EOS configuration" FontSize="20"/>
       <TextBox Text="{Binding EpicConfig.ProductId, Mode=TwoWay}" PlaceholderText="Product ID"/><TextBox Text="{Binding EpicConfig.SandboxId, Mode=TwoWay}" PlaceholderText="Sandbox ID"/><TextBox Text="{Binding EpicConfig.DeploymentId, Mode=TwoWay}" PlaceholderText="Deployment ID"/><TextBox Text="{Binding EpicConfig.ClientId, Mode=TwoWay}" PlaceholderText="Client ID"/><TextBox Text="{Binding EpicConfig.ClientSecret, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Client secret"/><TextBox Text="{Binding EpicConfig.EncryptionKey, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Encryption key"/><TextBox Text="{Binding EpicConfig.CaptureFolder, Mode=TwoWay}" PlaceholderText="Capture folder"/>
      </StackPanel>
      <StackPanel IsVisible="{Binding IsUbisoft}" Spacing="10"><TextBlock Text="Ubisoft configuration" FontSize="20"/>
       <TextBox Text="{Binding UbisoftConfig.ClientId, Mode=TwoWay}" PlaceholderText="Client ID"/><TextBox Text="{Binding UbisoftConfig.ClientSecret, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Client secret"/><TextBox Text="{Binding UbisoftConfig.SessionTicket, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Session ticket"/><TextBox Text="{Binding UbisoftConfig.SpaceId, Mode=TwoWay}" PlaceholderText="Space ID"/><TextBox Text="{Binding UbisoftConfig.Environment, Mode=TwoWay}" PlaceholderText="Environment"/><TextBox Text="{Binding UbisoftConfig.CaptureFolder, Mode=TwoWay}" PlaceholderText="Capture folder"/>
      </StackPanel><WrapPanel><Button Content="Save configuration" Click="SavePlatformConfig"/><Button Content="Open captures" Click="OpenPlatformCaptures"/><Button Content="Copy selected data" Click="CopyPlatformDetail"/></WrapPanel>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Achievement injector" IsVisible="{Binding IsUbisoft}"><Grid ColumnDefinitions="*,360" ColumnSpacing="18" Margin="16"><Grid RowDefinitions="Auto,*"><TextBox Text="{Binding PlatformSearch, Mode=TwoWay}" PlaceholderText="Filter Ubisoft spool catalog…"/><ListBox Grid.Row="1" ItemsSource="{Binding UbisoftSpools}" SelectedItem="{Binding SelectedUbisoftSpool, Mode=TwoWay}" Margin="0,12"><ListBox.ItemTemplate><DataTemplate x:DataType="local:UbisoftSpoolItem"><StackPanel Margin="8" Spacing="4"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding RelativePath}" Classes="muted" FontSize="10"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox></Grid><ScrollViewer Grid.Column="1"><StackPanel Spacing="14"><TextBlock Text="SPOOL INSTALLER" Classes="eyebrow"/><TextBlock Text="Copies the selected .spool file into the Ubisoft achievement cache. Existing files are timestamp-backed up." Classes="muted" TextWrapping="Wrap"/><TextBox Text="{Binding UbisoftSpoolTarget, Mode=TwoWay}" PlaceholderText="Ubisoft achievement spool folder"/><Button Content="Choose spool folder" Click="ChooseUbisoftSpoolFolder"/><Button Content="Install selected spool" Click="InstallUbisoftSpool" Classes="primary"/><Border Height="1" Background="{DynamicResource Line}" Margin="0,8"/><TextBlock Text="OVERLAY TOOL" Classes="eyebrow"/><TextBlock Text="Installs the supplied Steam006 overlay tool into a selected game folder and retains the original Ubisoft overlay DLL." Classes="muted" TextWrapping="Wrap"/><ComboBox ItemsSource="{Binding UbisoftOverlayArchitectures}" SelectedItem="{Binding UbisoftOverlayArchitecture, Mode=TwoWay}"/><TextBox Text="{Binding UbisoftOverlayTarget, Mode=TwoWay}" PlaceholderText="Ubisoft game overlay folder"/><Button Content="Choose game folder" Click="ChooseUbisoftOverlayFolder"/><Button Content="Install overlay tool" Click="InstallUbisoftOverlay"/><TextBlock Text="{Binding UbisoftToolStatus}" TextWrapping="Wrap"/></StackPanel></ScrollViewer></Grid></TabItem>
     </TabControl>
    </Grid>
   </Grid>
   <Grid Grid.Row="1" IsVisible="{Binding IsSpoofer}" RowDefinitions="Auto,*" RowSpacing="18">
    <Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding PresenceTitleId, Mode=TwoWay}" PlaceholderText="Xbox title ID" Tag="lookup-spoof" KeyDown="SubmitTextField"/><Button Grid.Column="1" Content="Look up title" Click="LookupSpoofTitle" IsEnabled="{Binding CanLookupSpoofTitle}" Margin="10,0"/><Button Grid.Column="2" Content="{Binding PresenceRunning, StringFormat={}{0}}" IsVisible="False"/></Grid>
     <Border Grid.Row="1" Classes="panel" Padding="24"><Grid ColumnDefinitions="300,*,220" ColumnSpacing="24"><Grid><Border Background="#0E1110" CornerRadius="10"/><local:RemoteImage Url="{Binding SpoofTitleImageUrl}" Stretch="UniformToFill"/></Grid><StackPanel Grid.Column="1" Spacing="14"><TextBlock Text="SPOOFED TITLE" Classes="eyebrow"/><SelectableTextBlock Text="{Binding SpoofTitleName}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding SpoofTitleDetails}" Classes="muted" TextWrapping="Wrap" LineHeight="22"/><TextBlock Text="{Binding StatsOutput}" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Column="2" Spacing="12"><TextBlock Text="PRESENCE" Classes="eyebrow"/><TextBlock Text="{Binding SpoofingStatus}" TextWrapping="Wrap" FontSize="16" FontWeight="SemiBold"/><TextBlock x:Name="SpooferSessionTimer" Text="{Binding PresenceTimer}" FontSize="18" FontWeight="SemiBold"/><TextBlock Text="{Binding PresenceElapsed}" TextWrapping="Wrap"/><Button Content="Start spoofing" Click="StartPresence" IsEnabled="{Binding CanStartPresence}" Classes="primary"/><Button Content="Stop spoofing" Click="StopPresence" IsEnabled="{Binding PresenceRunning}"/></StackPanel></Grid></Border>
   </Grid>
   <Grid Grid.Row="1" IsVisible="{Binding IsStats}" RowDefinitions="Auto,*">
    <Border Classes="panel" Padding="24"><StackPanel Spacing="14"><TextBlock Text="Game statistics" FontSize="24"/>
     <Grid ColumnDefinitions="*,*,Auto"><TextBox Text="{Binding StatsTitleId, Mode=TwoWay}" PlaceholderText="Title ID"/><TextBox Grid.Column="1" Text="{Binding ServiceConfigId, Mode=TwoWay}" PlaceholderText="Service configuration ID (optional for reads)" Margin="10,0"/><Button Grid.Column="2" Content="Read stats" Click="ReadStats" IsEnabled="{Binding CanQuery}"/></Grid>
     <Grid ColumnDefinitions="*,*,Auto"><TextBox Text="{Binding StatName, Mode=TwoWay}" PlaceholderText="Stat name"/><TextBox Grid.Column="1" Text="{Binding StatValue, Mode=TwoWay}" PlaceholderText="JSON value" Margin="10,0"/><Button Grid.Column="2" Content="Write stat" Click="WriteStat" IsEnabled="{Binding CanQuery}"/></Grid>
     <Button Content="Use selected achievement title" Click="UseStatsTitle"/>
<Grid ColumnDefinitions="*,Auto,Auto"><TextBox Text="{Binding PresenceTitleId, Mode=TwoWay}" PlaceholderText="Title ID for presence"/><Button Grid.Column="1" Content="Start presence" Click="StartPresence" IsEnabled="{Binding CanStartPresence}" Margin="10,0"/><Button Grid.Column="2" Content="Stop presence" Click="StopPresence" IsEnabled="{Binding PresenceRunning}"/></Grid>
    </StackPanel></Border>
    <TabControl Grid.Row="1" Margin="0,15,0,0"><TabItem Header="Discovered stats"><Grid RowDefinitions="Auto,*"><StackPanel Spacing="8"><Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding StatsEditor.TitleId, Mode=TwoWay}" IsEnabled="{Binding StatsEditor.CanEditTitle}" PlaceholderText="Title ID"/><Button Grid.Column="1" Content="Load stats" Command="{Binding StatsEditor.LoadStatsCommand}" IsEnabled="{Binding CanQuery}"/></Grid><StackPanel Orientation="Horizontal" Spacing="8"><Button Content="Save discovered stats" Command="{Binding StatsEditor.SaveDiscoveredStatsCommand}"/><Button Content="Update changed stats" Command="{Binding StatsEditor.UpdateAllStatsCommand}" IsEnabled="{Binding CanQuery}"/></StackPanel><TextBlock Name="StatModeLabel" Text="{Binding StatsEditor.StatModeLabel}" FontWeight="SemiBold"/><TextBlock Name="StatSupportLabel" Text="{Binding StatsEditor.StatSupportLabel}" TextWrapping="Wrap" Classes="muted"/><TextBlock Text="{Binding StatsEditor.StatusText}" TextWrapping="Wrap"/></StackPanel><ListBox Grid.Row="1" ItemsSource="{Binding StatsEditor.StatItems}" IsEnabled="{Binding StatsEditor.CanEditTitle}"><ListBox.ItemTemplate><DataTemplate x:DataType="workflows:StatsEditorViewModel+StatDisplayItem"><Grid ColumnDefinitions="*,100,140,Auto" Margin="8"><StackPanel><TextBlock Text="{Binding DisplayLabel}" TextWrapping="Wrap"/><TextBlock Text="{Binding Source}" Classes="muted"/><TextBlock Text="{Binding EditStatus}" Classes="muted"/></StackPanel><TextBlock Grid.Column="1" Text="{Binding CurrentValue}"/><TextBox Grid.Column="2" Text="{Binding NewValue, Mode=TwoWay}" IsEnabled="{Binding IsEditable}"/><Button Grid.Column="3" Content="Set" Tag="{Binding}" Click="SetDiscoveredStat" IsEnabled="{Binding IsEditable}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></TabItem><TabItem Header="Raw response"><TextBox Text="{Binding StatsOutput}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap"/></TabItem></TabControl>
   </Grid>
   <Grid Grid.Row="1" IsVisible="{Binding IsSettings}" RowDefinitions="Auto,*" RowSpacing="16">
    <Button Name="SaveAllSettings" Content="Save all settings" Classes="primary" Click="SaveSettings" HorizontalAlignment="Left"/>
    <TabControl Name="DesktopSettingsTabs" Grid.Row="1">
     <TabItem Header="Account"><ScrollViewer><StackPanel Spacing="18" MaxWidth="900" Margin="0,14,14,14">
<Border Classes="panel" Padding="24"><StackPanel Spacing="12"><TextBlock Text="Account and event settings" FontSize="22"/>
      <TextBlock Text="Events folder"/>
      <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding EventsDirectory, Mode=TwoWay}"/><Button Grid.Column="1" Content="Browse…" Click="ChooseEvents" Margin="10,0,0,0"/></Grid>
      <TextBlock Text="Saved Xbox session file"/>
      <Grid ColumnDefinitions="*,Auto"><TextBox Text="{Binding SessionPath, Mode=TwoWay}"/><Button Grid.Column="1" Content="Browse…" Click="ChooseSession" Margin="10,0,0,0"/></Grid>
      <CheckBox Content="Region override (applies on next connection)" IsChecked="{Binding RegionOverride, Mode=TwoWay}"/>
      <Border Classes="panel" Padding="16"><StackPanel Spacing="10"><TextBlock Text="Event token" FontSize="18"/><TextBlock Text="Paste a current Xbox events token here. It is encrypted for this Windows user and checked before every event-based unlock." Classes="muted" TextWrapping="Wrap"/><TextBox Text="{Binding EventTokenInput, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Paste event token" Tag="save-token" KeyDown="SubmitTextField"/><TextBlock Text="{Binding EventTokenStatus}" Classes="muted" TextWrapping="Wrap"/><TextBlock Text="{Binding AuthorizationStatus}" Classes="muted" TextWrapping="Wrap"/><WrapPanel><Button Name="AcquireConnectedAccountEventToken" Content="Get token for connected account" Click="AcquireAccountEventToken" IsEnabled="{Binding CanAcquireAccountEventToken}"/><Button Content="Save event token" Click="SaveEventToken" Classes="primary"/><Button Content="Remove saved token" Click="ClearEventToken"/></WrapPanel></StackPanel></Border>
      </StackPanel></Border>
<Border Classes="panel" Padding="24"><StackPanel Spacing="14">
      <Border Classes="panel" Padding="14"><TextBlock Text="Legacy local API disabled: unauthenticated account and token export is not available." TextWrapping="Wrap" Classes="muted"/></Border>
<TextBlock Text="Xbox account" FontSize="22"/><TextBlock Text="{Binding ProfileName}"/>
      <TextBlock Text="Achievement Labs first attaches to the account already signed in to the Xbox PC app. No browser or pasted link is needed for this method." TextWrapping="Wrap" Classes="muted"/>
      <Border Classes="panel" Padding="16"><StackPanel Spacing="9"><TextBlock Text="{Binding XboxPcAttachmentLabel}" Foreground="#91CFB1" FontWeight="SemiBold"/><TextBlock Text="{Binding XboxPcAttachmentDetail}" Classes="muted" TextWrapping="Wrap"/><WrapPanel><Button Content="Attach to Xbox PC app" Click="ConnectXbox" IsEnabled="{Binding CanConnect}" Classes="primary"/><Button Content="Open Xbox app and retry" Click="LaunchXboxAndAttach" IsEnabled="{Binding CanConnect}" Margin="8,0,0,0"/></WrapPanel></StackPanel></Border>
      <Border Classes="panel" Padding="16" IsVisible="{Binding OAuthFallbackAvailable}"><StackPanel Spacing="10"><TextBlock Text="Microsoft OAuth fallback" FontSize="18"/><TextBlock Text="Use this only when Xbox PC app attachment fails. Try a protected saved sign-in first. For a new sign-in, copy the final login.live.com address and use the single paste-and-finish button." TextWrapping="Wrap" Classes="muted"/><Button Content="Use saved OAuth fallback" Click="ConnectSavedOAuth" IsEnabled="{Binding CanConnect}"/><ComboBox ItemsSource="{Binding OAuthProfiles}" SelectedItem="{Binding OAuthProfile, Mode=TwoWay}"/><Button Content="Open Microsoft sign-in" Click="StartBrowserLogin" IsEnabled="{Binding CanConnect}"/><TextBox Text="{Binding LoginRedirect, Mode=TwoWay}" PasswordChar="●" PlaceholderText="Final login.live.com redirect URL"/><CheckBox Content="Remember this fallback sign-in for this Windows user" IsChecked="{Binding RememberBrowserSession, Mode=TwoWay}"/><WrapPanel><Button Content="Paste copied address and finish" Click="PasteAndCompleteBrowserLogin" IsEnabled="{Binding CanConnect}" Classes="primary"/><Button Content="Complete typed OAuth sign-in" Click="CompleteBrowserLogin" IsEnabled="{Binding CanConnect}" Margin="8,0,0,0"/></WrapPanel><Expander Header="Advanced: manual authorization"><StackPanel Spacing="10"><TextBox Text="{Binding ManualAuthorization, Mode=TwoWay}" PasswordChar="●" PlaceholderText="XBL3.0 authorization"/><Button Content="Attach manual authorization" Click="AttachManual" IsEnabled="{Binding CanConnect}"/></StackPanel></Expander></StackPanel></Border>
<WrapPanel><Button Content="Disconnect" Click="Disconnect" IsEnabled="{Binding CanDisconnect}"/><Button Content="Forget saved native sign-in" Click="ForgetSavedSession" IsEnabled="{Binding CanConnect}"/></WrapPanel>
      <TextBlock Text="Disconnecting keeps the saved session file. Native preferences are saved separately from the existing app's settings." TextWrapping="Wrap" Classes="muted"/>
     </StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Sync"><ScrollViewer><StackPanel Spacing="18" MaxWidth="900" Margin="0,14,14,14">
<Border Classes="panel" Padding="24"><StackPanel Spacing="12">
      <TextBlock Text="Event catalogue updates" FontSize="22"/>
      <CheckBox Content="Automatically check the official repository for new event games" IsChecked="{Binding AutoRefreshEvents, Mode=TwoWay}"/>
      <TextBlock Text="Checks published Events.zip releases at startup and hourly. New validated titles are cached and labelled Testing. Existing local mappings and edition fixes are preserved. Refresh a game's achievement page after new data arrives." TextWrapping="Wrap" Classes="muted"/>
      <Button Content="Check for new event games now" Click="RefreshEventCatalogue" IsEnabled="{Binding CanRefreshEventCatalogue}"/>
      <Button Content="Import event pack JSON…" Click="ImportEventPack" IsEnabled="{Binding CanRefreshEventCatalogue}"/>
      <TextBlock Text="{Binding EventCatalogueStatus}" TextWrapping="Wrap" Classes="muted"/>
     </StackPanel></Border>
<Border Classes="panel" Padding="24"><StackPanel Spacing="12">
      <TextBlock Text="DLC and title-update sections" FontSize="22"/>
      <CheckBox Content="Automatically check for catalogue updates daily" IsChecked="{Binding AutoRefreshDlc, Mode=TwoWay}"/>
      <TextBlock Text="Checks run at startup and while the app is open. This downloads verified grouping metadata; it does not scan your account or unlock achievements." TextWrapping="Wrap" Classes="muted"/>
      <Button Name="RefreshDlcCatalogueNow" Content="Refresh DLC catalogue now" Click="RefreshDlcCatalogue" IsEnabled="{Binding CanRefreshDlcCatalogue}"/>
      <TextBlock Text="{Binding DlcCatalogueStatus}" TextWrapping="Wrap" Classes="muted"/>
     </StackPanel></Border>
<Border Classes="panel" Padding="24"><StackPanel Spacing="16">
      <TextBlock Text="Mobile sync (iOS / Android)" FontSize="22"/>
      <TextBlock Text="Export the connected account's current authorization and event token in an encrypted file. The separate pairing key expires with the file after 10 minutes. OAuth renewal credentials remain on this PC." TextWrapping="Wrap" Classes="muted"/>
      <Button Content="Show mobile QR code" Click="ShowMobileSync" IsEnabled="{Binding CanQuery}"/>
      <Button Content="Export encrypted mobile sign-in" Click="ExportMobileTransfer" IsEnabled="{Binding CanQuery}"/>
     </StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Library"><ScrollViewer><StackPanel Spacing="18" MaxWidth="900" Margin="0,14,14,14">
<Border Classes="panel" Padding="24"><StackPanel Spacing="12">
      <TextBlock Text="Library completion appearance" FontSize="22"/>
      <CheckBox Name="MythicIconSetting" Content="Show Mythic icon for completed base games" IsChecked="{Binding ShowMythicIcon, Mode=TwoWay}"/>
      <CheckBox Name="CompletedDlcSetting" Content="Highlight 100% completed games (including DLC and title updates)" IsChecked="{Binding HighlightCompletedDlcs, Mode=TwoWay}"/>
      <TextBlock Text="Indicators use verified achievement groups and progress for the connected account. All-achievement completion also proves the base game complete. Partially completed unclassified games remain unmarked; achievement order and 1,000G are not used as proof." TextWrapping="Wrap" Classes="muted"/>
      <Grid ColumnDefinitions="*,*" ColumnSpacing="12"><StackPanel Spacing="6"><TextBlock Text="Mythic icon colour"/><TextBox Text="{Binding MythicColour, Mode=TwoWay}" PlaceholderText="#70C98A"/></StackPanel><StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="100% completion background"/><TextBox Text="{Binding CompletedDlcColour, Mode=TwoWay}" PlaceholderText="#183A27"/></StackPanel></Grid>
      <TextBlock Text="Use hex colours (#RRGGBB or #AARRGGBB). Invalid colours use the defaults. Save settings to remember your choices." Classes="muted" TextWrapping="Wrap"/>
      <WrapPanel><Button Content="Reset completion colours" Click="ResetCompletionColours"/><Button Content="Save appearance" Click="SaveSettings" Margin="8,0,0,0"/></WrapPanel>
      <WrapPanel><Button Name="ImportSavedCompletionProgress" Content="Use saved export progress" Click="ImportCompletionExports" IsEnabled="{Binding CanImportCompletion}"/><Button Name="ScanMissingCompletionProgress" Content="Scan missing completion progress" Click="ScanCompletionProgress" IsEnabled="{Binding CanScanCompletion}" Margin="8,0,0,0"/><Button Content="Stop completion scan" Click="StopCompletionScan" IsVisible="{Binding CompletionScanRunning}" Margin="8,0,0,0"/></WrapPanel>
      <TextBlock Text="Saved bulk exports are imported automatically for the connected account. Scans read one title at a time and save progress as they go." TextWrapping="Wrap" Classes="muted"/>
      <TextBlock Text="{Binding CompletionStatus}" TextWrapping="Wrap" Classes="muted"/>
     </StackPanel></Border>
<Border Classes="panel" Padding="24"><StackPanel Spacing="12"><TextBlock Text="Achievement exports" FontSize="22"/><Button Name="ExportAllAchievements" Content="Export all achievements…" Click="OpenBulkAchievementExport" IsEnabled="{Binding CanQuery}"/></StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="App"><ScrollViewer><StackPanel Spacing="18" MaxWidth="900" Margin="0,14,14,14">
<Border Classes="panel" Padding="24"><StackPanel Spacing="12">
      <TextBlock Text="Window and appearance" FontSize="22"/>
      <CheckBox Content="Remember window size and position" IsChecked="{Binding RememberWindowSize, Mode=TwoWay}"/>
      <CheckBox Content="Always open maximized" IsChecked="{Binding AutoMaximize, Mode=TwoWay}"/>
      <TextBlock Text="When both are enabled, the app opens maximized and keeps your last normal window size and position for restoring. Save settings to remember these options." Classes="muted" TextWrapping="Wrap"/>
      <CheckBox Content="Mint accent" IsChecked="{Binding MintAccent, Mode=TwoWay}"/>
      <CheckBox Content="Privacy mode" IsChecked="{Binding PrivacyMode, Mode=TwoWay}"/>
     </StackPanel></Border>
<Border Classes="panel" Padding="24"><StackPanel Spacing="16">
      <TextBlock Text="App updates" FontSize="22"/>
      <CheckBox Content="Automatically check and download updates on launch" IsChecked="{Binding AutomaticallyCheckUpdates, Mode=TwoWay}"/>
      <TextBlock Text="{Binding UpdateStatus}" TextWrapping="Wrap"/>
      <WrapPanel><Button Content="Check for updates" Click="CheckUpdates" IsEnabled="{Binding CanCheckUpdates}"/><Button Content="Install and restart" Click="InstallUpdate" IsVisible="{Binding UpdateReady}" Margin="10,0,0,0"/></WrapPanel>
      <TextBlock Text="Save settings to remember your update preference." Classes="muted"/>
      </StackPanel></Border>
<Border Classes="panel" Padding="24"><StackPanel Spacing="12"><TextBlock Text="Unlock and startup behaviour" FontSize="22"/><CheckBox Content="Enable unlock-all for title-based achievements" IsChecked="{Binding UnlockAllEnabled, Mode=TwoWay}"/><CheckBox Content="Automatic title presence while viewing achievements" IsChecked="{Binding AutoSpoof, Mode=TwoWay}"/><CheckBox Content="Launch Xbox app at startup" IsChecked="{Binding AutoLaunchXboxApp, Mode=TwoWay}"/><CheckBox Content="Launch Xbox app hidden" IsChecked="{Binding LaunchXboxAppHidden, Mode=TwoWay}"/><CheckBox Content="Fake signature compatibility" IsChecked="{Binding FakeSignature, Mode=TwoWay}"/>

      </StackPanel></Border>
<Border Classes="panel" Padding="24"><StackPanel Spacing="12"><TextBlock Text="Notifications" FontSize="22"/><CheckBox Content="Windows notifications" IsChecked="{Binding WindowsNotificationsEnabled, Mode=TwoWay}"/><CheckBox Content="Notify when the spoofer stops unexpectedly" IsChecked="{Binding NotifySpooferStops, Mode=TwoWay}"/><CheckBox Content="Stop auto unlock if spoofing fails" IsChecked="{Binding StopAutoUnlockOnSpoofFailure, Mode=TwoWay}"/><CheckBox Content="Notify when auto unlock completes" IsChecked="{Binding NotifyAutoUnlockCompletion, Mode=TwoWay}"/><Button Content="Test Windows notification" Click="TestWindowsNotification" IsEnabled="{Binding WindowsNotificationsEnabled}"/><Button Classes="primary" Content="Save settings" Click="SaveSettings"/>
     </StackPanel></Border>
     </StackPanel></ScrollViewer></TabItem>
     <TabItem Header="Debug"><ScrollViewer><StackPanel Spacing="18" MaxWidth="900" Margin="0,14,14,14">
<Border Classes="panel" Padding="24"><Expander Header="Debug" IsExpanded="{Binding DebugExpanded, Mode=TwoWay}"><StackPanel Spacing="12" Margin="0,12,0,0">
      <TextBlock Text="Diagnostic reports and catalogue checks" FontSize="18"/>
      <WrapPanel><Button Content="Open export/debug reports" Click="OpenDebugReports"/><Button Content="Export verified totals" Click="ExportVerifiedTotals" IsEnabled="{Binding CanExportVerifiedTotals}" Margin="8,0,0,0"/></WrapPanel>
      <TextBlock Text="New export scan-error reports are stored in the export's debug folder. Older reports stay where they were saved." TextWrapping="Wrap" Classes="muted"/>
      <WrapPanel><Button Content="Initial DLC review" Tag="bulk" Click="OpenCatalogueReview"/><Button Content="DLC corrections review" Tag="corrections" Click="OpenCatalogueReview" Margin="8,0,0,0"/></WrapPanel>
      <WrapPanel><Button Content="Inspect event catalog" Click="InspectCatalog" IsEnabled="{Binding CanInteract}"/><Button Content="Test event replacements locally" Click="TestEventReplacements" IsEnabled="{Binding CanInteract}" Margin="8,0,0,0"/></WrapPanel>
      <TextBlock Text="{Binding CatalogSummary}" TextWrapping="Wrap" Classes="muted"/>
      <ListBox ItemsSource="{Binding CatalogFindings}" MaxHeight="260" Background="Transparent"><ListBox.ItemTemplate><DataTemplate x:DataType="core:CatalogFinding"><StackPanel Margin="8" Spacing="4"><TextBlock Text="{Binding TitleId}"/><TextBlock Text="{Binding Status}"/><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Classes="muted"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
     </StackPanel></Expander></Border>
     </StackPanel></ScrollViewer></TabItem>
    </TabControl>
   </Grid>
   <Grid Grid.Row="1" IsVisible="{Binding IsDiagnostics}" RowDefinitions="Auto,Auto,*">
    <Border Classes="panel" Padding="24"><StackPanel Spacing="12"><TextBlock Text="Event catalog integrity" FontSize="24"/><TextBlock Text="Check title blocks, supported IDs, and standalone template files. This inspection does not modify the catalog." TextWrapping="Wrap" Classes="muted"/><TextBlock Text="{Binding EventsDirectory}" TextWrapping="Wrap"/><WrapPanel><Button Content="Inspect catalog" Click="InspectCatalog" IsEnabled="{Binding CanInteract}"/><Button Content="Test event replacements" Click="TestEventReplacements" IsEnabled="{Binding CanInteract}" Margin="10,0"/></WrapPanel></StackPanel></Border>
    <TextBlock Grid.Row="1" Text="{Binding CatalogSummary}" Margin="0,18" TextWrapping="Wrap"/>
    <ListBox Grid.Row="2" ItemsSource="{Binding CatalogFindings}" Background="Transparent"><ListBox.ItemTemplate><DataTemplate x:DataType="core:CatalogFinding"><Grid ColumnDefinitions="120,170,*" Margin="10"><TextBlock Text="{Binding TitleId}"/><TextBlock Grid.Column="1" Text="{Binding Status}"/><TextBlock Grid.Column="2" Text="{Binding Detail}" TextWrapping="Wrap" Classes="muted"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
   </Grid>
  </Grid><Border Grid.Row="1" Grid.Column="1" Background="#050606" BorderBrush="#24272A" BorderThickness="0,1,0,0" Padding="24,0"><Grid ColumnDefinitions="*,Auto" VerticalAlignment="Center"><TextBlock Text="{Binding Notice}" Classes="muted" FontSize="10"/><TextBlock Grid.Column="1" Text="AL  /  NATIVE DEVELOPMENT" FontSize="9" LetterSpacing="1" Foreground="#747B87"/></Grid></Border>
 </Grid>
</Window>
