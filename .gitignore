# Event templates and title/stat catalogs are application source and are tracked.

# Third-party executable payloads stay local
/gfwlam/*.exe
/gfwlam/*.dll

node_modules/

# Roadmap snapshot is generated by tools/sync-roadmap.mjs, not authored
/site/assets/roadmap.json

# Reproducible SDK caches and isolated end-user release output
/.dotnet/
/.nuget-packages/
/releases/
/artifacts/release-work/
/artifacts/site-catalog/

# Avalonia build output carries copies of the private Events pack.
# /src/.../Events/ is already ignored above, but the build copies Data.json and
# every per-title template into artifacts/, where nothing covered them. These
# are generated, so the whole tree is ignored rather than individual subpaths.
/artifacts/

# Local research, previews, and generated reports
/outputs/
/prototypes/
/uplayachievements/
/design/
/docs/maintenance/file-inventory.csv
/docs/maintenance/folder-sizes.csv

# Private licensing service (maintained in the backup repository only)
/server/licensing/

# Generated Android packages and account-free catalogue copies
/android/.gradle/
/android/**/build/
/android/local.properties
/android/app/src/main/assets/catalogue/
/android/app/src/main/res/drawable/app_icon.png
/android/artifacts/
